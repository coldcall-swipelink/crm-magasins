# ─── Base de données ──────────────────────────────────────────────────────────
# Option A : Supabase (recommandé)
# Récupérez l'URL dans Supabase → Settings → Database → Connection string (mode Transaction)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Option B : PostgreSQL local
# DATABASE_URL="postgresql://postgres:password@localhost:5432/crm_magasins"

# Option C : Supabase avec pooler (production)
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ─── Next.js ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="changez-moi-en-production-avec-openssl-rand-base64-32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Bypass de l'écran de connexion (UserGate) — UNIQUEMENT pour les tests/preview.
# À "true", l'app s'ouvre sans demander d'identifiants. NE PAS activer en production.
# (Variable NEXT_PUBLIC_*, inlinée au build → redéployer après changement.)
# NEXT_PUBLIC_BYPASS_USER_GATE="true"

# ─── Authentification (connexion par email + mot de passe) ───────────────────
# Chaque utilisateur se connecte avec son email et un mot de passe fixé au
# préalable en base (champs User.email / User.passwordHash — hash scrypt).
#
# Provisionner / réinitialiser le mot de passe d'un utilisateur :
#   npm run user:set-password -- --email prenom@swipelink.fr --password "MotDePasse" --name "Prénom Nom"
#
# Mot de passe initial commun attribué aux comptes créés par `npm run db:seed`
# (à personnaliser ensuite compte par compte). Défaut : "changeme".
# SEED_USER_PASSWORD="changeme"

# ─── Assistant IA du Dashboard ───────────────────────────────────────────────
# Active le chat IA de l'onglet Dashboard : l'IA répond aux questions sur les
# données du CRM (closings, MRR, pipeline, affaires, actions…) en interrogeant
# la base en LECTURE SEULE via des outils. Il suffit de configurer UNE des deux
# options ci-dessous. Sans clé, le chat renvoie un message invitant à configurer.
#
# ── Option A (RECOMMANDÉE) : Groq — GRATUIT, sans carte, limites larges ────────
#   1. Aller sur https://console.groq.com/keys (se connecter avec Google/GitHub)
#   2. Cliquer « Create API Key » et copier la clé
GROQ_API_KEY=""                              # gsk_…
# Optionnel : modèle utilisé (défaut : llama-3.3-70b-versatile).
# GROQ_MODEL="llama-3.3-70b-versatile"
#
# ── Option B : Google Gemini — gratuit mais quotas très restreints ─────────────
# Utilisé si GROQ_API_KEY est vide. https://aistudio.google.com/apikey
# GEMINI_API_KEY=""                            # AIza…
# GEMINI_MODEL="gemini-2.0-flash"
#
# ── Option C : Claude (Anthropic) — payant à l'usage ──────────────────────────
# Utilisé si GROQ_API_KEY et GEMINI_API_KEY sont vides.
# https://console.anthropic.com → API Keys
# ANTHROPIC_API_KEY=""                         # sk-ant-…
# ANTHROPIC_MODEL="claude-sonnet-5"

# ─── Emails (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Expéditeur par défaut (fallback). Le composeur d'email permet aussi de choisir
# l'adresse d'envoi parmi les expéditeurs @swipelink.fr définis dans
# src/lib/emailSenders.ts (hugo / bilal / mark / luca). Le domaine étant vérifié
# chez Resend, aucun paramétrage supplémentaire n'est requis pour ces adresses.
SMTP_FROM="Swipelink <contact@swipelink.fr>"
#
# Webhook Resend (POST /api/webhooks/resend) : enregistre dans le deal tout
# email parti par Resend (depuis le CRM OU depuis une automatisation N8N), en
# retrouvant l'affaire via son email de contact. À configurer dans Resend →
# Webhooks, en activant les events : email.sent, email.delivered, email.opened
# et email.received (réponses, voir ci-dessous).
#
# ─── Réponses aux emails (Resend Inbound) — OPTIONNEL ────────────────────────
# Complément facultatif du relevé IMAP ci-dessus, qui couvre déjà l'essentiel.
# Son seul apport : un rattachement DÉTERMINISTE (l'id de l'affaire est encodé
# dans l'adresse de réponse) et en temps réel, là où l'IMAP rattache par fil de
# discussion ou par adresse de contact, à la fréquence du relevé. Les deux
# sources cohabitent sans créer de doublon (déduplication par Message-ID).
# Laissé vide, seul le relevé IMAP travaille — c'est un choix parfaitement viable.
#
# Une fois configuré,
# chaque email part avec un Reply-To vers « reply+<idAffaire>@<domaine> », la
# réponse est captée par Resend, journalisée dans la bonne affaire (frise +
# pastille « A répondu » sur la carte du pipeline) — et arrive toujours dans la
# boîte de l'expéditeur, qui reste en second Reply-To.
#
# Mise en place (une seule fois) :
#   1. Resend → Domains : ajoutez un sous-domaine dédié à la réception, ex.
#      « inbox.swipelink.fr ». Surtout PAS le domaine racine : son MX pointe
#      déjà vers l'hébergeur des boîtes @swipelink.fr, et le remplacer couperait
#      la réception de tous vos emails.
#   2. Chez le registrar : l'enregistrement MX indiqué par Resend sur ce
#      sous-domaine, avec la priorité la PLUS BASSE (sinon rien n'est routé).
#   3. Resend → Webhooks : activez l'event « email.received » sur l'endpoint
#      /api/webhooks/resend déjà utilisé.
#   4. Renseignez la variable ci-dessous.
# Laissée vide, la capture des réponses est simplement inactive (les envois
# repartent comme avant, Reply-To = expéditeur).
RESEND_INBOUND_DOMAIN=""

# ─── Réponses aux emails : relevé IMAP des boîtes OVH ────────────────────────
# Récupère les réponses des contacts directement dans les boîtes @swipelink.fr
# et les affiche dans la frise de l'affaire (+ pastille « A répondu » sur la
# carte du pipeline). Capte aussi bien les réponses aux emails du CRM que les
# mails qui l'ignorent : mail neuf, réponse à un vieil échange, clic sur
# l'adresse d'une signature.
#
# RIEN D'AUTRE À INSTALLER : le relevé se déclenche tout seul quand le pipeline
# est ouvert (il se greffe sur l'appel que le CRM fait déjà toutes les 60 s), et
# s'espace lui-même de 5 minutes. Pas de cron, pas de n8n, pas de jeton.
# Après une période sans usage, le premier chargement rattrape tout.
#
# Un mot de passe par boîte à relever, nommé d'après le libellé de l'expéditeur
# dans src/lib/emailSenders.ts (hugo / bilal / mark / luca). Une boîte sans mot
# de passe est ignorée : on peut n'en activer qu'une pour commencer. C'est la
# SEULE chose à renseigner.
IMAP_PASSWORD_HUGO=""
IMAP_PASSWORD_BILAL=""
IMAP_PASSWORD_MARK=""
IMAP_PASSWORD_LUCA=""
#
# Serveur OVH MX Plan : valeurs par défaut, à ne renseigner que si elles diffèrent.
# IMAP_HOST="ssl0.ovh.net"
# IMAP_PORT="993"
# IMAP_FOLDER="INBOX"
# IMAP_SYNC_INTERVAL_MIN="5"   # espacement minimal entre deux relevés
#
# Rattachement d'une réponse à une affaire, par ordre de fiabilité :
#   1. l'id d'affaire encodé dans l'adresse de réception (si RESEND_INBOUND_DOMAIN
#      est configuré, voir plus bas) ;
#   2. le fil de discussion : In-Reply-To / References de la réponse comparés au
#      Message-ID de l'envoi. Cela suppose que l'event Resend « email.sent » soit
#      actif — c'est lui qui renseigne ce Message-ID côté CRM ;
#   3. à défaut, l'adresse de l'expéditeur = email de contact de l'affaire.
#
# ─── Déclenchement manuel (facultatif) ───────────────────────────────────────
# Utile une seule fois, pour vérifier les identifiants OVH ou rattraper des
# réponses antérieures à la mise en service. Nécessite un jeton ; sans jeton
# renseigné la route reste fermée, ce qui n'empêche en rien le relevé
# automatique ci-dessus.
# EMAIL_SYNC_TOKEN=""
#   POST /api/emails/sync-replies            → relevé immédiat
#   POST /api/emails/sync-replies?days=7     → rattrapage des 7 derniers jours
# Le tout premier relevé pose seulement le curseur de lecture, sans rien
# importer : sinon tout l'historique des boîtes remonterait d'un coup dans les
# affaires. Le rattrapage `days` est rejouable sans créer de doublon.

# ─── Réponses aux emails (Resend Inbound) — OPTIONNEL ────────────────────────
# Complément facultatif du relevé IMAP ci-dessus, qui couvre déjà l'essentiel.
# Son seul apport : un rattachement DÉTERMINISTE (l'id de l'affaire est encodé
# dans l'adresse de réponse) et en temps réel, là où l'IMAP rattache par fil de
# discussion ou par adresse de contact, à la fréquence du relevé. Les deux
# sources cohabitent sans créer de doublon (déduplication par Message-ID).
# Laissé vide, seul le relevé IMAP travaille — c'est un choix parfaitement viable.
#
# Une fois configuré,
# chaque email part avec un Reply-To vers « reply+<idAffaire>@<domaine> », la
# réponse est captée par Resend, journalisée dans la bonne affaire (frise +
# pastille « A répondu » sur la carte du pipeline) — et arrive toujours dans la
# boîte de l'expéditeur, qui reste en second Reply-To.
#
# Mise en place (une seule fois) :
#   1. Resend → Domains : ajoutez un sous-domaine dédié à la réception, ex.
#      « inbox.swipelink.fr ». Surtout PAS le domaine racine : son MX pointe
#      déjà vers l'hébergeur des boîtes @swipelink.fr, et le remplacer couperait
#      la réception de tous vos emails.
#   2. Chez le registrar : l'enregistrement MX indiqué par Resend sur ce
#      sous-domaine, avec la priorité la PLUS BASSE (sinon rien n'est routé).
#   3. Resend → Webhooks : activez l'event « email.received » sur l'endpoint
#      /api/webhooks/resend déjà utilisé.
#   4. Renseignez la variable ci-dessous.
# Laissée vide, la capture des réponses est simplement inactive (les envois
# repartent comme avant, Reply-To = expéditeur).
RESEND_INBOUND_DOMAIN=""

# ─── Réponses : relevé IMAP des boîtes OVH (source principale) ───────────────
# Récupère les réponses des contacts directement dans les boîtes @swipelink.fr.
# C'est la voie la plus complète : elle capte aussi bien les réponses aux emails
# du CRM que les mails qui contournent le Reply-To (mail neuf, réponse à un vieil
# échange, clic sur l'adresse d'une signature).
#
# Serveur OVH MX Plan (valeurs par défaut, à ne renseigner que si elles diffèrent) :
# IMAP_HOST="ssl0.ovh.net"
# IMAP_PORT="993"
# IMAP_FOLDER="INBOX"
#
# Un mot de passe par boîte à relever, nommé d'après le libellé de l'expéditeur
# dans src/lib/emailSenders.ts (hugo / bilal / mark / luca). Une boîte sans mot
# de passe est ignorée : on peut n'en activer qu'une pour commencer.
IMAP_PASSWORD_HUGO=""
IMAP_PASSWORD_BILAL=""
IMAP_PASSWORD_MARK=""
IMAP_PASSWORD_LUCA=""
#
# Jeton protégeant le déclenchement du relevé. Obligatoire : sans lui la route
# répond 401 (elle lit des boîtes mail).
EMAIL_SYNC_TOKEN=""
#
# Déclenchement, à brancher sur N8N ou le planificateur de l'hébergeur, toutes
# les 5 à 15 minutes :
#   POST /api/emails/sync-replies?token=$EMAIL_SYNC_TOKEN
#
# Le PREMIER relevé pose seulement le curseur de lecture, sans rien importer :
# sinon tout l'historique des boîtes remonterait d'un coup dans les affaires.
# Pour un rattrapage volontaire (rejouable sans créer de doublon) :
#   POST /api/emails/sync-replies?token=…&days=7
#
# Rattachement d'une réponse à une affaire, par ordre de fiabilité :
#   1. l'id d'affaire encodé dans l'adresse de réception (si RESEND_INBOUND_DOMAIN
#      est configuré, voir plus bas) ;
#   2. le fil de discussion : In-Reply-To / References de la réponse comparés au
#      Message-ID de l'envoi. Cela suppose que l'event Resend « email.sent » soit
#      actif — c'est lui qui renseigne ce Message-ID côté CRM ;
#   3. à défaut, l'adresse de l'expéditeur = email de contact de l'affaire.

# ─── Google Calendar + Meet (étape « Démo prévue ») ──────────────────────────
# Quand une affaire passe en « Démo prévue », l'app crée un événement Google
# Calendar avec un Google Meet « Ouvert à tous » et invite le contact de
# l'affaire + bilal@swipelink.fr.
#
# Mise en place (OAuth2, à faire une seule fois) :
#   1. Google Cloud Console → créez un projet, activez « Google Calendar API »
#      ET « Google Meet API ».
#   2. Créez un identifiant OAuth 2.0 de type « Application de bureau ».
#   3. Générez un refresh token avec les scopes :
#        https://www.googleapis.com/auth/calendar.events
#        https://www.googleapis.com/auth/meetings.space.created
#      (ex. via https://developers.google.com/oauthplayground en réglant vos
#       propres client_id/secret dans les paramètres ⚙, ou via un script local).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# Optionnel :
# GOOGLE_CALENDAR_ID="primary"              # agenda où créer l'événement
# GOOGLE_MEET_GUEST_EMAIL="bilal@swipelink.fr"  # invité systématique
# GOOGLE_MEET_DURATION_MIN="30"             # durée de l'événement en minutes
# GOOGLE_MEET_TIMEZONE="Europe/Paris"       # fuseau horaire de l'événement

# ─── Base produit Supabase (étape « Démo prévue ») ───────────────────────────
# Quand une affaire passe en « Démo prévue », en plus de l'invitation Google
# Meet, l'app crée dans la base PRODUIT (projet Supabase distinct du CRM) :
#   - une Organization (« Enseigne — Ville », avec logo selon l'enseigne)
#   - un Organization_to_plan (plan « One shot »)
#   - un Recruiter (admin, rattaché à un user fixe)
# Utiliser l'URL + la clé service_role (ou « secret ») du projet voulu.
# Si ces variables ne sont pas définies, l'étape est ignorée silencieusement.
SUPABASE_PRODUCT_URL=""                      # ex : https://xxxxxxxx.supabase.co
SUPABASE_PRODUCT_SERVICE_ROLE_KEY=""         # clé service_role / secret

# Au passage en « SMARTLINKÉ » (pipeline Closing), l'app crée en plus, sur
# l'Organization déjà rattachée au deal, un Recruiter « Support »
# (company_position = « Support »). Son user_id est propre au Support et
# INDÉPENDANT de SUPABASE_PRODUCT_RECRUITER_USER_ID (défaut : e05bd473-…).
# Idempotent : pas de doublon si l'affaire repasse dans la colonne.
#
# Optionnel (sinon valeurs par défaut dans le code) :
# SUPABASE_PRODUCT_PLAN_ID="38fb7e63-922e-45d9-9c35-a614edf7cc93"   # plan One shot
# SUPABASE_PRODUCT_RECRUITER_USER_ID="0c72c8d6-98a1-4aa5-8e91-91a70277bcaa"
# SUPABASE_PRODUCT_SMARTLINK_CREDITS="0"
# SUPABASE_PRODUCT_SUPPORT_RECRUITER_USER_ID="e05bd473-a010-4658-b0b7-cfd5e344b919"
# SUPABASE_PRODUCT_SUPPORT_COMPANY_POSITION="Support"

# ─── Recherche automatique des numéros de magasins ───────────────────────────
# Retrouve le numéro de téléphone de chaque magasin sans le chercher à la main.
# Pilotage : Paramètres → « Numéros de téléphone des magasins », ou en ligne de
# commande : `npm run phones:lookup -- --run`.
#
# Deux sources, utilisées en cascade :
#   1. OpenStreetMap (GRATUIT, aucune clé) — toujours actif. Une seule requête
#      par « enseigne × département » couvre des dizaines de magasins.
#   2. Google Places (PAYANT, facultatif) — n'est interrogé que pour les
#      magasins qu'OpenStreetMap n'a pas permis de résoudre. C'est la même
#      donnée que la fiche Google consultée manuellement.
#
# ── Recherche web (RECOMMANDÉE) : reproduit la recherche faite à la main ─────
# Exécute « numéro de téléphone <enseigne> <magasin> » sur Google et relève le
# numéro de la fiche de l'établissement — exactement la manipulation manuelle.
# C'est la source qui couvre le mieux les enseignes françaises, OpenStreetMap ne
# cartographiant qu'une partie des commerces.
#
# Mise en place : créer un compte sur https://serper.dev (quelques milliers de
# recherches offertes à l'inscription, largement de quoi traiter une base
# entière), puis copier la clé ci-dessous.
SERPER_API_KEY=""                            # clé serper.dev
#
# Interroger google.com DIRECTEMENT, sans service intermédiaire. Déconseillé :
# Google bloque les adresses des hébergeurs et renvoie une page de consentement
# ou un CAPTCHA à la place des résultats. Fonctionne en revanche depuis un poste
# de travail (npm run phones:lookup). Désactivé par défaut.
# PHONE_WEB_DIRECT_GOOGLE="true"

# Mise en place de Google Places (facultative) :
#   1. Google Cloud Console → créer/choisir un projet, activer la facturation.
#   2. Activer l'API « Places API (New) ».
#   3. API et services → Identifiants → créer une clé d'API, et la restreindre
#      à l'API Places (recommandé).
# Sans clé, tout continue de fonctionner : seule la couverture est plus faible.
GOOGLE_PLACES_API_KEY=""                     # AIza…
#
# Instance Overpass à utiliser. RECOMMANDÉ de la changer pour une campagne de
# masse : l'instance publique par défaut (overpass-api.de) est très sollicitée
# et met couramment 30 à 40 secondes à répondre, contre 2 à 3 secondes sur un
# miroir moins chargé. La campagne s'adapte (elle mesure le temps réel et
# dimensionne ses lots en conséquence), mais elle avancera bien plus vite.
# OVERPASS_ENDPOINT="https://overpass.kumi.systems/api/interpreter"

# ─── Stripe (liens de paiement) ──────────────────────────────────────────────
# Le bouton « Envoyer un lien de paiement » de la fiche affaire liste les
# Payment Links ACTIFS de votre compte Stripe, et construit pour chacun l'URL
# finale en ajoutant « ?client_reference_id=<ref> » :
#   - <ref> = group_id de l'Organization si elle est rattachée à un groupe
#             (colonne group_id de la table Organization, base produit Supabase)
#   - <ref> = organization_id sinon
# Utiliser la clé SECRÈTE Stripe (Dashboard → Développeurs → Clés API).
# Si cette variable n'est pas définie, la fonctionnalité est désactivée.
STRIPE_SECRET_KEY=""                         # sk_live_… ou sk_test_…
