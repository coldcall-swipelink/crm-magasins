# ─── Base de données ──────────────────────────────────────────────────────────
# Option A : Supabase (recommandé)
# Récupérez l'URL dans Supabase → Settings → Database → Connection string (mode Transaction)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Option B : PostgreSQL local
# DATABASE_URL="postgresql://postgres:password@localhost:5432/crm_magasins"

# Option C : Supabase avec pooler (production)
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ─── Next.js ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="changez-moi-en-production-avec-openssl-rand-base64-32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Bypass de l'écran de connexion (UserGate) — UNIQUEMENT pour les tests/preview.
# À "true", l'app s'ouvre sans demander d'identifiants. NE PAS activer en production.
# (Variable NEXT_PUBLIC_*, inlinée au build → redéployer après changement.)
# NEXT_PUBLIC_BYPASS_USER_GATE="true"

# ─── Authentification (connexion par email + mot de passe) ───────────────────
# Chaque utilisateur se connecte avec son email et un mot de passe fixé au
# préalable en base (champs User.email / User.passwordHash — hash scrypt).
#
# Provisionner / réinitialiser le mot de passe d'un utilisateur :
#   npm run user:set-password -- --email prenom@swipelink.fr --password "MotDePasse" --name "Prénom Nom"
#
# Mot de passe initial commun attribué aux comptes créés par `npm run db:seed`
# (à personnaliser ensuite compte par compte). Défaut : "changeme".
# SEED_USER_PASSWORD="changeme"

# ─── Assistant IA du Dashboard ───────────────────────────────────────────────
# Active le chat IA de l'onglet Dashboard : l'IA répond aux questions sur les
# données du CRM (closings, MRR, pipeline, affaires, actions…) en interrogeant
# la base en LECTURE SEULE via des outils. Il suffit de configurer UNE des deux
# options ci-dessous. Sans clé, le chat renvoie un message invitant à configurer.
#
# ── Option A (RECOMMANDÉE) : Groq — GRATUIT, sans carte, limites larges ────────
#   1. Aller sur https://console.groq.com/keys (se connecter avec Google/GitHub)
#   2. Cliquer « Create API Key » et copier la clé
GROQ_API_KEY=""                              # gsk_…
# Optionnel : modèle utilisé (défaut : llama-3.3-70b-versatile).
# GROQ_MODEL="llama-3.3-70b-versatile"
#
# ── Option B : Google Gemini — gratuit mais quotas très restreints ─────────────
# Utilisé si GROQ_API_KEY est vide. https://aistudio.google.com/apikey
# GEMINI_API_KEY=""                            # AIza…
# GEMINI_MODEL="gemini-2.0-flash"
#
# ── Option C : Claude (Anthropic) — payant à l'usage ──────────────────────────
# Utilisé si GROQ_API_KEY et GEMINI_API_KEY sont vides.
# https://console.anthropic.com → API Keys
# ANTHROPIC_API_KEY=""                         # sk-ant-…
# ANTHROPIC_MODEL="claude-sonnet-5"

# ─── Emails (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Expéditeur par défaut (fallback). Le composeur d'email permet aussi de choisir
# l'adresse d'envoi parmi les expéditeurs @swipelink.fr définis dans
# src/lib/emailSenders.ts (hugo / bilal / mark / luca). Le domaine étant vérifié
# chez Resend, aucun paramétrage supplémentaire n'est requis pour ces adresses.
SMTP_FROM="Swipelink <contact@swipelink.fr>"
#
# Webhook Resend (POST /api/webhooks/resend) : enregistre dans le deal tout
# email parti par Resend (depuis le CRM OU depuis une automatisation N8N), en
# retrouvant l'affaire via son email de contact. À configurer dans Resend →
# Webhooks, en activant les events : email.sent, email.delivered, email.opened
# et email.received (réponses, voir ci-dessous).
#
# ─── Réponses aux emails (Resend Inbound) — OPTIONNEL ────────────────────────
# Complément facultatif du relevé IMAP ci-dessus, qui couvre déjà l'essentiel.
# Son seul apport : un rattachement DÉTERMINISTE (l'id de l'affaire est encodé
# dans l'adresse de réponse) et en temps réel, là où l'IMAP rattache par fil de
# discussion ou par adresse de contact, à la fréquence du relevé. Les deux
# sources cohabitent sans créer de doublon (déduplication par Message-ID).
# Laissé vide, seul le relevé IMAP travaille — c'est un choix parfaitement viable.
#
# Une fois configuré,
# chaque email part avec un Reply-To vers « reply+<idAffaire>@<domaine> », la
# réponse est captée par Resend, journalisée dans la bonne affaire (frise +
# pastille « A répondu » sur la carte du pipeline) — et arrive toujours dans la
# boîte de l'expéditeur, qui reste en second Reply-To.
#
# Mise en place (une seule fois) :
#   1. Resend → Domains : ajoutez un sous-domaine dédié à la réception, ex.
#      « inbox.swipelink.fr ». Surtout PAS le domaine racine : son MX pointe
#      déjà vers l'hébergeur des boîtes @swipelink.fr, et le remplacer couperait
#      la réception de tous vos emails.
#   2. Chez le registrar : l'enregistrement MX indiqué par Resend sur ce
#      sous-domaine, avec la priorité la PLUS BASSE (sinon rien n'est routé).
#   3. Resend → Webhooks : activez l'event « email.received » sur l'endpoint
#      /api/webhooks/resend déjà utilisé.
#   4. Renseignez la variable ci-dessous.
# Laissée vide, la capture des réponses est simplement inactive (les envois
# repartent comme avant, Reply-To = expéditeur).
RESEND_INBOUND_DOMAIN=""

# ─── Réponses aux emails : relevé IMAP des boîtes OVH ────────────────────────
# Récupère les réponses des contacts directement dans les boîtes @swipelink.fr
# et les affiche dans la frise de l'affaire (+ pastille « A répondu » sur la
# carte du pipeline). Capte aussi bien les réponses aux emails du CRM que les
# mails qui l'ignorent : mail neuf, réponse à un vieil échange, clic sur
# l'adresse d'une signature.
#
# RIEN D'AUTRE À INSTALLER : le relevé se déclenche tout seul quand le pipeline
# est ouvert (il se greffe sur l'appel que le CRM fait déjà toutes les 60 s), et
# s'espace lui-même de 5 minutes. Pas de cron, pas de n8n, pas de jeton.
# Après une période sans usage, le premier chargement rattrape tout.
#
# Le mot de passe de chaque boîte (celui qui ouvre le webmail OVH), nommé
# d'après le libellé de l'expéditeur
# dans src/lib/emailSenders.ts (hugo / bilal / mark / luca). Une boîte sans mot
# de passe est ignorée : on peut n'en activer qu'une pour commencer. C'est la
# SEULE chose à renseigner.
IMAP_PASSWORD_HUGO=""
IMAP_PASSWORD_BILAL=""
IMAP_PASSWORD_MARK=""
IMAP_PASSWORD_LUCA=""
#
# Serveur OVH MX Plan : valeurs par défaut, à ne renseigner que si elles diffèrent.
# IMAP_HOST="ssl0.ovh.net"
# IMAP_PORT="993"
# IMAP_FOLDER="INBOX"
# IMAP_SYNC_INTERVAL_MIN="5"   # espacement minimal entre deux relevés
#
# Rattachement d'une réponse à une affaire, par ordre de fiabilité :
#   1. l'id d'affaire encodé dans l'adresse de réception (si RESEND_INBOUND_DOMAIN
#      est configuré, voir plus bas) ;
#   2. le fil de discussion : In-Reply-To / References de la réponse comparés au
#      Message-ID de l'envoi. Cela suppose que l'event Resend « email.sent » soit
#      actif — c'est lui qui renseigne ce Message-ID côté CRM ;
#   3. à défaut, l'adresse de l'expéditeur = email de contact de l'affaire.
#
# ─── Déclenchement manuel (facultatif) ───────────────────────────────────────
# Utile une seule fois, pour vérifier les identifiants OVH ou rattraper des
# réponses antérieures à la mise en service. Nécessite un jeton ; sans jeton
# renseigné la route reste fermée, ce qui n'empêche en rien le relevé
# automatique ci-dessus.
# EMAIL_SYNC_TOKEN=""
#   POST /api/emails/sync-replies            → relevé immédiat
#   POST /api/emails/sync-replies?days=7     → rattrapage des 7 derniers jours
# Le tout premier relevé pose seulement le curseur de lecture, sans rien
# importer : sinon tout l'historique des boîtes remonterait d'un coup dans les
# affaires. Le rattrapage `days` est rejouable sans créer de doublon.

# ─── Réponses aux emails (Resend Inbound) — OPTIONNEL ────────────────────────
# Complément facultatif du relevé IMAP ci-dessus, qui couvre déjà l'essentiel.
# Son seul apport : un rattachement DÉTERMINISTE (l'id de l'affaire est encodé
# dans l'adresse de réponse) et en temps réel, là où l'IMAP rattache par fil de
# discussion ou par adresse de contact, à la fréquence du relevé. Les deux
# sources cohabitent sans créer de doublon (déduplication par Message-ID).
# Laissé vide, seul le relevé IMAP travaille — c'est un choix parfaitement viable.
#
# Une fois configuré,
# chaque email part avec un Reply-To vers « reply+<idAffaire>@<domaine> », la
# réponse est captée par Resend, journalisée dans la bonne affaire (frise +
# pastille « A répondu » sur la carte du pipeline) — et arrive toujours dans la
# boîte de l'expéditeur, qui reste en second Reply-To.
#
# Mise en place (une seule fois) :
#   1. Resend → Domains : ajoutez un sous-domaine dédié à la réception, ex.
#      « inbox.swipelink.fr ». Surtout PAS le domaine racine : son MX pointe
#      déjà vers l'hébergeur des boîtes @swipelink.fr, et le remplacer couperait
#      la réception de tous vos emails.
#   2. Chez le registrar : l'enregistrement MX indiqué par Resend sur ce
#      sous-domaine, avec la priorité la PLUS BASSE (sinon rien n'est routé).
#   3. Resend → Webhooks : activez l'event « email.received » sur l'endpoint
#      /api/webhooks/resend déjà utilisé.
#   4. Renseignez la variable ci-dessous.
# Laissée vide, la capture des réponses est simplement inactive (les envois
# repartent comme avant, Reply-To = expéditeur).
RESEND_INBOUND_DOMAIN=""

# ─── Réponses : relevé IMAP des boîtes OVH (source principale) ───────────────
# Récupère les réponses des contacts directement dans les boîtes @swipelink.fr.
# C'est la voie la plus complète : elle capte aussi bien les réponses aux emails
# du CRM que les mails qui contournent le Reply-To (mail neuf, réponse à un vieil
# échange, clic sur l'adresse d'une signature).
#
# Serveur OVH MX Plan (valeurs par défaut, à ne renseigner que si elles diffèrent) :
# IMAP_HOST="ssl0.ovh.net"
# IMAP_PORT="993"
# IMAP_FOLDER="INBOX"
#
# Un mot de passe par boîte à relever, nommé d'après le libellé de l'expéditeur
# dans src/lib/emailSenders.ts (hugo / bilal / mark / luca). Une boîte sans mot
# de passe est ignorée : on peut n'en activer qu'une pour commencer.
IMAP_PASSWORD_HUGO=""
IMAP_PASSWORD_BILAL=""
IMAP_PASSWORD_MARK=""
IMAP_PASSWORD_LUCA=""
#
# Jeton protégeant le déclenchement du relevé. Obligatoire : sans lui la route
# répond 401 (elle lit des boîtes mail).
EMAIL_SYNC_TOKEN=""
#
# Déclenchement, à brancher sur N8N ou le planificateur de l'hébergeur, toutes
# les 5 à 15 minutes :
#   POST /api/emails/sync-replies?token=$EMAIL_SYNC_TOKEN
#
# Le PREMIER relevé pose seulement le curseur de lecture, sans rien importer :
# sinon tout l'historique des boîtes remonterait d'un coup dans les affaires.
# Pour un rattrapage volontaire (rejouable sans créer de doublon) :
#   POST /api/emails/sync-replies?token=…&days=7
#
# Rattachement d'une réponse à une affaire, par ordre de fiabilité :
#   1. l'id d'affaire encodé dans l'adresse de réception (si RESEND_INBOUND_DOMAIN
#      est configuré, voir plus bas) ;
#   2. le fil de discussion : In-Reply-To / References de la réponse comparés au
#      Message-ID de l'envoi. Cela suppose que l'event Resend « email.sent » soit
#      actif — c'est lui qui renseigne ce Message-ID côté CRM ;
#   3. à défaut, l'adresse de l'expéditeur = email de contact de l'affaire.

# ─── Google Calendar + Meet (étape « Démo prévue ») ──────────────────────────
# Quand une affaire passe en « Démo prévue », l'app crée un événement Google
# Calendar avec un Google Meet « Ouvert à tous » et invite le contact de
# l'affaire + bilal@swipelink.fr.
#
# Mise en place (OAuth2, à faire une seule fois) :
#   1. Google Cloud Console → créez un projet, activez « Google Calendar API »
#      ET « Google Meet API ».
#   2. Créez un identifiant OAuth 2.0 de type « Application de bureau ».
#   3. Générez le refresh token :  npm run google:auth
#      Le script affiche l'adresse de consentement puis récupère le code, soit
#      tout seul sur http://localhost:5555/oauth2callback (script lancé sur la
#      machine du navigateur), soit par collage de l'adresse de retour (script
#      lancé sur une machine distante : Codespace, serveur, SSH).
#      Il demande les autorisations :
#        https://www.googleapis.com/auth/calendar
#        https://www.googleapis.com/auth/meetings.space.created
#      « calendar » (et non « calendar.events ») est nécessaire : c'est lui qui
#      autorise la LECTURE de l'agenda pour le bouton « Afficher les dispos ».
#      Un jeton limité à calendar.events fait échouer cette lecture en 403
#      (ACCESS_TOKEN_SCOPE_INSUFFICIENT) — il faut alors relancer google:auth.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# Optionnel :
# GOOGLE_CALENDAR_ID="primary"              # agenda où créer l'événement
# GOOGLE_MEET_GUEST_EMAIL="bilal@swipelink.fr"  # invité systématique
# GOOGLE_MEET_DURATION_MIN="30"             # durée de l'événement en minutes
# GOOGLE_MEET_TIMEZONE="Europe/Paris"       # fuseau horaire de l'événement
#
# Le même agenda alimente le bouton « Afficher les dispos » de la fiche affaire
# (lecture seule, créneaux de 30 minutes, navigation par semaine). Bornes de la
# plage affichée, en heures locales du fuseau ci-dessus :
# CALENDAR_START_HOUR="9"
# CALENDAR_END_HOUR="19"

# ─── Fond de la carte des magasins (facultatif) ──────────────────────────────
# CARTO a rendu ses fonds de carte payants : sans clé, ses tuiles arrivent
# barrées d'un filigrane « API KEY REQUIRED ».
#
# Laissé VIDE, la carte bascule sur les tuiles libres d'OpenStreetMap, sans
# inscription ni filigrane. Elles sont en couleurs : le CRM les désature pour
# retrouver le gris clair d'origine.
#
# Renseigné (clé gratuite sur https://carto.com/basemaps/apikey), on retrouve
# le fond CARTO pour lequel la carte a été dessinée, et ses tuiles doubles sur
# écran Retina. Le préfixe NEXT_PUBLIC_ est OBLIGATOIRE : c'est le navigateur
# qui charge les tuiles, pas le serveur.
# NEXT_PUBLIC_CARTO_API_KEY=""

# ─── Base produit Supabase (étape « Démo prévue ») ───────────────────────────
# Quand une affaire passe en « Démo prévue », en plus de l'invitation Google
# Meet, l'app crée dans la base PRODUIT (projet Supabase distinct du CRM) :
#   - une Organization (« Enseigne — Ville », avec logo selon l'enseigne)
#   - un Organization_to_plan (plan « One shot »)
#   - un Recruiter (admin, rattaché à un user fixe)
# Utiliser l'URL + la clé service_role (ou « secret ») du projet voulu.
# Si ces variables ne sont pas définies, l'étape est ignorée silencieusement.
SUPABASE_PRODUCT_URL=""                      # ex : https://xxxxxxxx.supabase.co
SUPABASE_PRODUCT_SERVICE_ROLE_KEY=""         # clé service_role / secret

# Au passage en « SMARTLINKÉ » (pipeline Closing), l'app crée en plus, sur
# l'Organization déjà rattachée au deal, un Recruiter « Support »
# (company_position = « Support »). Son user_id est propre au Support et
# INDÉPENDANT de SUPABASE_PRODUCT_RECRUITER_USER_ID (défaut : e05bd473-…).
# Idempotent : pas de doublon si l'affaire repasse dans la colonne.
#
# Optionnel (sinon valeurs par défaut dans le code) :
# SUPABASE_PRODUCT_PLAN_ID="38fb7e63-922e-45d9-9c35-a614edf7cc93"   # plan One shot
# SUPABASE_PRODUCT_RECRUITER_USER_ID="0c72c8d6-98a1-4aa5-8e91-91a70277bcaa"
# SUPABASE_PRODUCT_SMARTLINK_CREDITS="0"
# SUPABASE_PRODUCT_SUPPORT_RECRUITER_USER_ID="e05bd473-a010-4658-b0b7-cfd5e344b919"
# SUPABASE_PRODUCT_SUPPORT_COMPANY_POSITION="Support"

# Ces deux mêmes variables suffisent au bouton « ＋ Créer un user » (onglet
# « Recrutement » d'une affaire), qui crée pour le magasin, avec un seul
# user_id : le compte dans l'onglet « Authentication » (mot de passe 00000000),
# sa ligne « User » (nom, prénom, email) et sa ligne « Recruiter » sur
# l'organisation du deal (poste, cgu_pp_accepted et is_admin à true,
# configured_at à l'instant de la création). Rien de plus à configurer : la clé
# service_role donne accès à l'API Auth admin comme aux tables.

# ─── Recherche automatique des numéros de magasins ───────────────────────────
# Retrouve le numéro de téléphone de chaque magasin sans le chercher à la main.
# Pilotage : Paramètres → « Numéros de téléphone des magasins », ou en ligne de
# commande : `npm run phones:lookup -- --run`.
#
# Deux sources, utilisées en cascade :
#   1. OpenStreetMap (GRATUIT, aucune clé) — toujours actif. Une seule requête
#      par « enseigne × département » couvre des dizaines de magasins.
#   2. Google Places (PAYANT, facultatif) — n'est interrogé que pour les
#      magasins qu'OpenStreetMap n'a pas permis de résoudre. C'est la même
#      donnée que la fiche Google consultée manuellement.
#
# ── Recherche web (RECOMMANDÉE) : reproduit la recherche faite à la main ─────
# Exécute « numéro de téléphone <enseigne> <magasin> » sur Google et relève le
# numéro de la fiche de l'établissement — exactement la manipulation manuelle.
# C'est la source qui couvre le mieux les enseignes françaises, OpenStreetMap ne
# cartographiant qu'une partie des commerces.
#
# Mise en place : créer un compte sur https://serper.dev (quelques milliers de
# recherches offertes à l'inscription, largement de quoi traiter une base
# entière), puis copier la clé ci-dessous.
SERPER_API_KEY=""                            # clé serper.dev
#
# Interroger google.com DIRECTEMENT, sans service intermédiaire. Déconseillé :
# Google bloque les adresses des hébergeurs et renvoie une page de consentement
# ou un CAPTCHA à la place des résultats. Fonctionne en revanche depuis un poste
# de travail (npm run phones:lookup). Désactivé par défaut.
# PHONE_WEB_DIRECT_GOOGLE="true"

# Mise en place de Google Places (facultative) :
#   1. Google Cloud Console → créer/choisir un projet, activer la facturation.
#   2. Activer l'API « Places API (New) ».
#   3. API et services → Identifiants → créer une clé d'API, et la restreindre
#      à l'API Places (recommandé).
# Sans clé, tout continue de fonctionner : seule la couverture est plus faible.
GOOGLE_PLACES_API_KEY=""                     # AIza…
#
# Instance Overpass à utiliser. RECOMMANDÉ de la changer pour une campagne de
# masse : l'instance publique par défaut (overpass-api.de) est très sollicitée
# et met couramment 30 à 40 secondes à répondre, contre 2 à 3 secondes sur un
# miroir moins chargé. La campagne s'adapte (elle mesure le temps réel et
# dimensionne ses lots en conséquence), mais elle avancera bien plus vite.
# OVERPASS_ENDPOINT="https://overpass.kumi.systems/api/interpreter"

# ─── Stripe (liens de paiement) ──────────────────────────────────────────────
# Le bouton « Envoyer un lien de paiement » de la fiche affaire liste les
# Payment Links ACTIFS de votre compte Stripe, et construit pour chacun l'URL
# finale en ajoutant « ?client_reference_id=<ref> » :
#   - <ref> = group_id de l'Organization si elle est rattachée à un groupe
#             (colonne group_id de la table Organization, base produit Supabase)
#   - <ref> = organization_id sinon
# Utiliser la clé SECRÈTE Stripe (Dashboard → Développeurs → Clés API).
# Si cette variable n'est pas définie, la fonctionnalité est désactivée.
STRIPE_SECRET_KEY=""                         # sk_live_… ou sk_test_…

# ─── Écran d'accueil (dépôt tv-swipelink) ────────────────────────────────────
# L'écran accroché au mur relève GET /api/tv/closings/latest en boucle et joue
# une animation quand un closing vient d'être enregistré : enseigne + magasin,
# closeur, montant. La route est en LECTURE SEULE et volontairement à l'écart du
# chemin d'écriture des closings — brancher l'écran ne peut rien casser dans
# l'enregistrement d'un contrat.
#
# Ne sont renvoyés que les closings de MOINS DE 10 MINUTES, et jamais ceux dont
# `source` vaut "backfill" : une reprise d'historique ne doit pas faire défiler
# d'anciens contrats sur le mur. Une correction ultérieure (date, closeur,
# montant) passe par un update, qui ne change pas l'identifiant renvoyé : elle
# ne rejoue donc pas à l'écran.
#
# Le jeton est comparé au paramètre ?token= de la requête. Sans jeton renseigné
# la route répond 404 et l'écran continue simplement d'afficher la slide.
# Générer avec : openssl rand -base64 32
# La même valeur est à reporter dans la variable CRM_FEED_TOKEN du projet
# Vercel tv-swipelink, qui appelle cette route côté serveur (le jeton ne
# descend jamais dans le navigateur).
TV_FEED_TOKEN=""

# ═══════════════════════════════════════════════════════════════════════════
# RÉCEPTION AUTOMATIQUE DES OFFRES (N8N → CRM)
# ═══════════════════════════════════════════════════════════════════════════
#
# L'automatisation N8N n'envoie plus son Excel par email : elle pousse ses
# offres directement dans le CRM, qui les met en attente de tri.
#
#   POST /api/webhooks/job-offers?token=$OFFERS_WEBHOOK_TOKEN
#   (jeton aussi accepté en en-tête « Authorization: Bearer … »
#    ou « X-Webhook-Token: … »)
#
# Corps accepté, au choix selon ce que produit le workflow :
#   • un tableau d'offres     [{"enseigne":"Leclerc","ville":"Rennes", …}, …]
#   • un objet enveloppe      {"label":"Indeed 12/03","source":"n8n-indeed",
#                              "rows":[ … ]}      (ou "offers" / "data" / "items")
#   • un CSV entier           {"csv":"enseigne;ville;…\n…"}
#   • du CSV brut             (Content-Type: text/csv)
#
# Les noms de colonnes sont ceux de l'import manuel (« enseigne », « nom
# magasin », « ville », « code postal », « adresse », « poste », « titre »,
# « date publication », « lien », « salaire », « contrat », « source »,
# « id offre »…) : le fichier déjà produit par N8N passe tel quel.
#
# Les offres n'entrent PAS dans le pipeline : elles s'empilent dans la boîte de
# réception. À l'ouverture du CRM, une popup « Nouvelles offres reçues » liste
# les offres à cocher ; les cochées suivent les règles habituelles de l'import
# (nouveau magasin → « À appeler », nouvelle offre sur un magasin suivi →
# retour en « À appeler »), les autres sont écartées. Le tri reste accessible
# à tout moment depuis l'écran « Offres reçues ».
#
# Le webhook est rejouable : une offre déjà reçue (importée, écartée ou encore
# en attente) est ignorée et comptée dans « duplicates » de la réponse.
#
# Sans jeton renseigné la route répond 401 (elle écrit en base).
# Générer avec : openssl rand -base64 32
OFFERS_WEBHOOK_TOKEN=""

# ═══════════════════════════════════════════════════════════════════════════
# ENVOIS D'EMAILS PROGRAMMÉS
# ═══════════════════════════════════════════════════════════════════════════
#
# Depuis la fiche affaire, un email peut être programmé (« demain 9 h »). Il est
# écrit en base, visible et annulable dans la frise, et part au premier passage
# de :
#
#   POST /api/emails/send-scheduled?token=$EMAIL_SYNC_TOKEN
#
# Cet appel est fait TOUT SEUL par le cron Vercel déclaré dans vercel.json
# (toutes les dix minutes) : il n'y a rien à brancher sur N8N. Il suffit de
# renseigner CRON_SECRET ci-dessous — Vercel le présente de lui-même à ses
# crons, en en-tête « Authorization: Bearer … ».
#
# Sur le plan Hobby, Vercel limite les crons à un par jour : la précision de
# l'heure d'envoi tomberait à 24 h. Dans ce cas seulement, appelez la même
# route depuis N8N toutes les 5 à 15 minutes, avec EMAIL_SYNC_TOKEN.
#
# Jetons acceptés, au choix : CRON_SECRET, EMAIL_SYNC_TOKEN, OFFERS_WEBHOOK_TOKEN.
CRON_SECRET=""                               # openssl rand -hex 32
#
# Rejouable : chaque email est réservé avant envoi, deux passages simultanés
# ne peuvent pas le faire partir deux fois. Réponse 503 si RESEND_API_KEY
# manque — la file est alors préservée, rien n'est perdu.

# ═══════════════════════════════════════════════════════════════════════════
# OUTIL CAMPAGNES (séquences d'emails)
# ═══════════════════════════════════════════════════════════════════════════
#
# L'onglet « Campagnes » envoie EN DIRECT depuis de vraies boîtes mail
# (Google Workspace, OVH), sans passer par un routeur transactionnel. Les
# adresses expéditrices ne se déclarent donc plus ici : elles s'ajoutent dans
# l'interface (Campagnes → Boîtes d'envoi), qui teste la connexion SMTP et
# IMAP avant d'enregistrer quoi que ce soit.
#
# Une seule variable est nécessaire : la clé qui chiffre les mots de passe de
# ces boîtes en base (AES-256-GCM). Sans elle, aucune boîte ne peut être
# enregistrée — on n'écrit jamais un mot de passe en clair.
#
#   openssl rand -hex 32
#
CAMPAIGN_SECRET_KEY=""
#
# ATTENTION : changer cette clé rend ILLISIBLES les mots de passe déjà
# enregistrés. Il faut alors ressaisir celui de chaque boîte.
#
# ─── Côté fournisseur, la mise en place d'une boîte ──────────────────────────
#
# Ces mots de passe ne sont PAS des variables d'environnement : ils se saisissent
# dans l'interface (Campagnes → Boîtes d'envoi), et le CRM les chiffre en base
# avec la clé ci-dessus.
#
# Google Workspace / Gmail
#   Le mot de passe habituel du compte est refusé en SMTP : il faut un
#   « mot de passe d'application ».
#   1. Le compte doit avoir la validation en deux étapes activée.
#   2. Connecté avec CETTE adresse : https://myaccount.google.com/apppasswords
#      → nommer l'application, copier les 16 caractères, les coller dans le CRM.
#      (Les espaces entre les blocs sont retirés à l'enregistrement.)
#   3. Serveurs pré-remplis : smtp.gmail.com:465 (TLS) et imap.gmail.com:993.
#      L'accès IMAP doit être autorisé (Gmail → Paramètres → Transfert et
#      POP/IMAP), sinon le relevé des réponses échouera.
#   Quota indicatif : ~2 000 destinataires/jour sur Workspace (500 en compte
#   gratuit). Le plafond « Envois / jour » du CRM doit rester en dessous.
#
# OVH (MX Plan)
#   Le mot de passe de la boîte, celui qui ouvre le webmail.
#   Serveurs pré-remplis : ssl0.ovh.net:465 (SMTP) et ssl0.ovh.net:993 (IMAP).
#
# Autre hébergeur : renseigner les serveurs à la main dans le formulaire.

# ─── Campagnes : automatisation et liens des emails ─────────────────────────
#
# Deux crons déclarés dans vercel.json, authentifiés par le CRON_SECRET
# ci-dessus (mêmes jetons acceptés que les envois programmés) :
#
#   POST /api/campaigns/run           toutes les 5 min  → fait partir les emails dus
#   POST /api/campaigns/sync-replies  toutes les 10 min → relève les réponses (IMAP)
#                                                         et arrête les séquences
#
# Le second est indispensable : sans lui, une campagne continue de relancer un
# lead qui a déjà répondu. Les deux sont rejouables sans risque de doublon.
#
# NEXT_PUBLIC_APP_URL (plus haut) doit pointer sur l'adresse réelle du CRM :
# c'est la base des liens de suivi d'ouverture et de désinscription insérés
# dans les emails. Mal renseignée, le pixel et le lien ne fonctionnent pas.

# ═══════════════════════════════════════════════════════════════════════════
# PILOTE « PROSPECTION DE VALEUR » — PARCOURS BOUCHER
# ═══════════════════════════════════════════════════════════════════════════
#
# Le principe : un magasin publie une offre de boucher, son directeur reçoit un
# mail dont l'unique bouton ouvre rdv.swipelink.fr/boucher?t=<jeton>. Il répond
# à trois questions et réserve une démo de 15 min en visio. Tout ce qui suit
# (agenda, affaire, rappels) est tenu par le CRM.
#
# ── Ce qui est déjà couvert par les variables plus haut ────────────────────
#
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REFRESH_TOKEN
#       L'agenda des démos est celui DÉJÀ connecté au CRM. Rien à reconnecter.
#   CAMPAIGN_SECRET_KEY
#       Chiffre aussi les jetons d'invitation (copie relisible pour les rappels,
#       cf. PvInvite.tokenCipher). Sans elle, chaque rappel doit émettre un
#       nouveau jeton, ce qui casse le lien « déplacer » déjà posé dans
#       l'agenda du directeur : à renseigner.
#   CRON_SECRET
#       Protège /api/pv/invites, /api/pv/reminders et /api/pv/follow-ups.
#   RESEND_API_KEY
#       Confirmations, rappels et relances (messages attendus).

# ── Adresse publique de la page ────────────────────────────────────────────
#
# Le domaine qui sert le parcours. À déclarer dans Vercel (Settings → Domains)
# sur CE projet : la page est une route du CRM, /boucher.
#
#   rdv.swipelink.fr   CNAME   cname.vercel-dns.com
#
PV_PUBLIC_URL="https://rdv.swipelink.fr"

# ── Expéditeur et consultant affiché ───────────────────────────────────────
#
# Le mail est signé Hugo et c'est Hugo que la page annonce en visio : la même
# personne du premier message au rendez-vous.
PV_SENDER_EMAIL="hugo@swipelink.fr"
PV_SENDER_NAME="Hugo, Swipelink"
PV_CONSULTANT_PRENOM="Hugo"
PV_CONSULTANT_ROLE="consultant recrutement"
# Facultatif : sans photo, la page affiche l'initiale dans une pastille.
PV_CONSULTANT_PHOTO_URL=""
# Numéro affiché sur la page (« Si vous avez des questions, appelez Hugo au… »).
PV_CONSULTANT_PHONE="0769719845"
# Invité systématique de l'événement d'agenda (celui qui anime la démo).
PV_GUEST_EMAIL="hugo@swipelink.fr"
# Adresse postale de l'éditeur, obligatoire en bas d'un message commercial.
PV_LEGAL_ADDRESS="Swipelink SAS, …"

# ── Créneaux proposés ──────────────────────────────────────────────────────
#
# Valeurs par défaut entre parenthèses : elles suffisent, elles ne sont là que
# pour ajuster le pilote sans redéployer.
#
# PV_CALENDAR_ID          agenda des démos (défaut : GOOGLE_CALENDAR_ID)
# PV_DEMO_DURATION_MIN    durée RÉSERVÉE dans l'agenda, en minutes (30)
#                         Volontairement plus longue que les 15 min annoncées
#                         au directeur : on promet un rendez-vous court — c'est
#                         ce qui le fait accepter — et on garde la marge pour
#                         une démo qui s'étire. Ne touche que l'événement
#                         d'agenda, le .ics et la grille ; les « 15 min » des
#                         textes sont éditoriaux (src/pv-assets/,
#                         src/lib/pv/notifications.ts).
# PV_SLOT_STEP_MIN        pas de la grille, en minutes (30 → des créneaux qui se
#                         suivent, la marge étant portée par la réservation)
# PV_MIN_NOTICE_H         délai minimum avant un créneau, en heures (48 = J+2 :
#                         le temps de chasser les deux profils avant la démo)
# PV_WINDOW_DAYS          profondeur de l'agenda proposé, en jours (14)
# PV_START_HOUR           première heure proposée (9)
# PV_END_HOUR             dernière heure proposée (18)
# PV_DAYS                 jours ouverts, ISO 1=lundi … 7=dimanche (1,2,3,4,5)
# PV_TOKEN_TTL_DAYS       validité d'un jeton d'invitation, en jours (30)
#
# ── Pitch « pourquoi c'est gratuit » (volet gauche de la page) ─────────────
#
# Le texte dépend de l'enseigne (src/lib/pv/pitch.ts). Seuls les nombres de
# magasins sont réglables ici ; sans valeur, la page dit « accompagne déjà des… ».
#
# PV_PITCH_INTERMARCHE_COUNT   « plus de N Intermarché » (45)
# PV_PITCH_LECLERC_COUNT       « plus de N E.Leclerc » (aucun)
# PV_PITCH_U_COUNT             « plus de N Super U et Hyper U » (aucun)

# ── SMS de rappel (Twilio) ─────────────────────────────────────────────────
#
# Les rappels de la veille et d'une heure avant partent en e-mail ET en SMS.
# Sans ces variables, seul l'e-mail part — le rappel n'échoue pas pour autant.
# TWILIO_FROM ou TWILIO_MESSAGING_SERVICE_SID : l'un des deux suffit.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
TWILIO_MESSAGING_SERVICE_SID=""

# ── Délivrabilité du mail d'invitation ─────────────────────────────────────
#
# C'est un message FROID, adressé à un directeur qui ne nous connaît pas. Il
# part donc d'une boîte de l'outil Campagnes (Paramètres → Boîtes d'envoi), et
# non du canal transactionnel : c'est elle qui porte le domaine dédié, le
# plafond quotidien, la cadence irrégulière et le préchauffage.
#
# À FAIRE AVANT LE PREMIER ENVOI, sans exception :
#
#   1. DOMAINE D'ENVOI DÉDIÉ (ex. swipelink-rdv.fr, mail.swipelink.fr). Jamais
#      le domaine principal : une réputation abîmée sur un domaine froid ne doit
#      pas emporter les mails de facturation et de support.
#
#   2. SPF    TXT @    "v=spf1 include:<votre fournisseur> -all"
#      DKIM   la paire de clés fournie par l'hébergeur de la boîte, publiée
#             sur le sélecteur qu'il indique.
#      DMARC  TXT _dmarc  "v=DMARC1; p=none; rua=mailto:dmarc@swipelink.fr"
#             p=none le premier mois (on observe les rapports), puis
#             p=quarantine une fois que SPF et DKIM alignent.
#
#   3. PRÉCHAUFFAGE, dans la fiche de la boîte d'envoi :
#        warmupStart  10   → plafond du premier jour
#        warmupStep    5   → +5 par jour
#        dailyLimit   80   → plafond de croisière (3 à 4 semaines plus tard)
#      Et on n'ouvre PV_SENDER_EMAIL au pilote qu'une fois ce palier atteint.
#
#   4. Vérifier le rendu sur Outlook Windows, Gmail et iOS avant le premier
#      envoi réel : c'est le seul moyen de voir le logo intégré (CID) et les
#      replis de couleur unie prévus pour Outlook.
