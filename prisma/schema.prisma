generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stores    Store[]
}

model Store {
  id                String      @id @default(cuid())
  brandId           String?
  brand             Brand?      @relation(fields: [brandId], references: [id])
  name              String
  normalizedName    String
  city              String      @default("")
  postalCode        String      @default("")
  department        String      @default("")
  address           String      @default("")
  phone             String      @default("")
  email             String      @default("")
  siret             String      @default("")
  externalId        String      @default("")
  deduplicationKey  String      @unique
  // Coordonnées GPS issues du géocodage de l'adresse (API BAN data.gouv).
  // Mises en cache pour éviter de re-géocoder à chaque ouverture de la carte.
  latitude          Float?
  longitude         Float?
  geocodedAt        DateTime?
  geocodeQuery      String      @default("")
  // ── Recherche automatique du numéro de téléphone (cf. src/lib/phone) ──
  // Le numéro du magasin est retrouvé sur OpenStreetMap puis, à défaut, sur la
  // fiche Google de l'établissement. Ces colonnes gardent la trace de la
  // recherche pour ne jamais la refaire inutilement et pour pouvoir arbitrer
  // les cas douteux depuis l'interface.
  //   phoneSource       : "osm" | "google" | "manuel" | "import"
  //   phoneLookupStatus : "" (jamais cherché) | "trouve" | "a_verifier"
  //                       | "introuvable" | "erreur"
  //   phoneCandidates   : numéros proposés + indices de correspondance, servant
  //                       à la file de revue (statut "a_verifier").
  phoneSource       String      @default("")
  phoneLookupStatus String      @default("")
  phoneLookupAt     DateTime?
  phoneCandidates   Json?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deal              Deal?
  jobOffers         JobOffer[]
  importRows        ImportRow[]

  @@index([phoneLookupStatus])
}

model Collaborator {
  id        String   @id @default(cuid())
  name      String
  email     String   @default("")
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deals     Deal[]
}

// Liste configurable (Paramètres) des types d'abonnement sélectionnables sur
// la fiche affaire (onglet « Abonnement »). Le deal stocke le nom choisi.
model SubscriptionType {
  id        String   @id @default(cuid())
  name      String   @unique
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Utilisateur de l'application (identité choisie à la première connexion,
// stockée côté navigateur). Complémentaire de Collaborator : sert à savoir
// qui est connecté, qui suit un deal, à qui une action est assignée et qui
// rédige une note.
model User {
  id                  String         @id @default(cuid())
  name                String         @unique
  // Identifiants de connexion. Optionnels pour ne pas casser les utilisateurs
  // historiques créés à la volée (assignation d'affaires) sans compte : seuls
  // les comptes disposant d'un email + passwordHash peuvent se connecter.
  email               String?        @unique
  passwordHash        String? // hash scrypt « salt:hash » — jamais renvoyé au client
  color               String         @default("#6366f1")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  assignedDeals       Deal[]
  assignedActions     Action[]
  authoredNotes       Note[]
  callLogs            CallLog[]
  dealMoves           DealMove[]
  demoBookings        DemoBooking[]  @relation("DemoBookedBy")
  demosDone           DemoBooking[]  @relation("DemoDoneBy")
  closedSubscriptions Subscription[]
  closingEvents       ClosingEvent[]
  // Leads de prospection (outil Campagnes) dont l'utilisateur a la charge.
  campaignLeads       Lead[]
}

model Pipeline {
  id        String   @id @default(cuid())
  name      String   @unique
  position  Int      @default(0)
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  columns PipelineColumn[]
  deals   Deal[]
}

model PipelineColumn {
  id         String   @id @default(cuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  title      String
  position   Int
  color      String   @default("#6366f1")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deals Deal[]
}

model Deal {
  id                        String              @id @default(cuid())
  pipelineId                String
  pipeline                  Pipeline            @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  storeId                   String              @unique
  store                     Store               @relation(fields: [storeId], references: [id])
  columnId                  String
  column                    PipelineColumn      @relation(fields: [columnId], references: [id])
  previousColumnId          String?
  // Regroupement d'affaires : un « gros » deal peut en absorber d'autres
  // (autres magasins d'un même groupe). Un sous-deal disparaît du pipeline et
  // reste accessible via son parent ou la recherche. Limité à un seul niveau.
  parentDealId              String?
  parentDeal                Deal?               @relation("DealHierarchy", fields: [parentDealId], references: [id], onDelete: SetNull)
  childDeals                Deal[]              @relation("DealHierarchy")
  priority                  String              @default("normale")
  // Tag commercial : true = Prospection de Valeur (PV), false = Prospection
  // Classique (PC). Affiché sous forme de puce à cocher sur chaque affaire.
  isPV                      Boolean             @default(true)
  // Mode de paiement choisi pour les affaires en étape « SMARTLINKÉ » :
  // "stripe" (par défaut) ou "virement". Affiché sous forme d'interrupteur sur
  // la fiche affaire uniquement quand l'affaire est dans cette étape.
  paymentMode               String              @default("stripe")
  position                  Int                 @default(0)
  isNewFromLastImport       Boolean             @default(false)
  hasNewOfferFromLastImport Boolean             @default(false)
  isPresentInLastImport     Boolean             @default(true)
  movedToCallAt             DateTime?
  lastImportAt              DateTime?
  directeur                 String              @default("")
  contactCalling            String              @default("")
  // Fonction du contact calling, choisie directement depuis la deal card.
  contactPosition           String              @default("")
  dealEmail                 String              @default("")
  contactCivilite           String              @default("Monsieur")
  contactLastName           String              @default("")
  // Numéro de téléphone du contact, saisi manuellement sur la fiche affaire.
  // Masqué par défaut : il faut cliquer sur « Afficher le numéro » pour le
  // dévoiler, et ce clic est comptabilisé comme un appel (cf. CallLog).
  contactPhone              String              @default("")
  dealValue                 Float?
  demoDate                  DateTime?
  // Date du DERNIER booking de démo (dernière entrée dans « DEMO PREVUE » du
  // pipeline Closing). Simple miroir dénormalisé de la ligne DemoBooking la
  // plus récente, conservé pour les lectures rapides ; l'historique complet
  // (un rebooking = une ligne de plus) vit dans DemoBooking.
  demoBookedAt              DateTime?
  candidateCallDate         DateTime?
  // Date de closing : renseignée à l'entrée dans l'étape « SMARTLINKÉ »
  // (demandée au drag & drop) et modifiable depuis l'onglet « Abonnement ».
  closingDate               DateTime?
  // ----- Abonnement (onglet « Abonnement » de la fiche affaire) -----
  // Nom du type d'abonnement choisi (liste configurable dans Paramètres).
  subscriptionType          String              @default("")
  // Cadence de paiement : "comptant" (par défaut) ou "mensuel".
  paymentTiming             String              @default("comptant")
  // Durée totale de l'abonnement en mois (1 an = 12 par défaut).
  subscriptionMonths        Int                 @default(12)
  // Date de fin calculée automatiquement = closingDate + subscriptionMonths.
  subscriptionEndDate       DateTime?
  googleEventId             String?
  googleMeetUrl             String?
  // Id de l'Organization créée dans la base produit Supabase quand l'affaire
  // passe en « Démo prévue » (garantit l'idempotence du provisioning).
  supabaseOrganizationId    String?
  // True quand l'utilisateur a géré manuellement les organisations rattachées :
  // on n'exécute alors plus le rattachement automatique par nom.
  supabaseOrgManual         Boolean             @default(false)
  // Date du premier relevé des offres produit (Supabase) rattachées à l'affaire.
  // Sert de ligne de base : les offres déjà présentes lors de ce premier relevé
  // sont marquées « lues » (pré-existantes) ; seules les offres créées ENSUITE
  // déclenchent point bleu + notification + trace d'activité. Null = jamais relevé.
  offersSyncedAt            DateTime?
  // Date de la dernière réponse reçue par email (miroir dénormalisé du dernier
  // EmailLog entrant). Alimente la pastille « A répondu » des cartes du
  // pipeline sans avoir à compter les emails de chaque affaire.
  lastEmailReplyAt          DateTime?
  // ─── Pilote « Prospection de Valeur » : parcours boucher ──────────────────
  // Le magasin est cité en référence auprès d'un prospect voisin de la même
  // enseigne (bloc « déjà avec Swipelink dans votre région »), même s'il n'est
  // pas dans le pipeline Closing. Les affaires du pipeline Closing (test déjà
  // fait) sont citées d'office (cf. src/lib/pv/references.ts).
  citableReference          Boolean             @default(false)
  // Réponses du parcours, recopiées depuis PvInvite au moment de la
  // réservation. Miroir dénormalisé, comme demoDate : la source reste
  // l'invitation, mais la fiche affaire et les filtres les lisent ici.
  pvExperience              String              @default("")
  pvSalaire                 String              @default("")
  pvPriseDePoste            String              @default("")
  // E-mail confirmé par le directeur sur la page (il a pu corriger celui du
  // magasin) et acceptation des CGU au moment de la réservation.
  pvEmailValidatedAt        DateTime?
  pvCguAcceptedAt           DateTime?
  collaboratorId            String?
  collaborator              Collaborator?       @relation(fields: [collaboratorId], references: [id])
  assignedUserId            String?
  assignedUser              User?               @relation(fields: [assignedUserId], references: [id])
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  jobOffers                 JobOffer[]
  actions                   Action[]
  notes                     Note[]
  importRows                ImportRow[]
  emailLogs                 EmailLog[]
  candidateCalls            CandidateCall[]
  callLogs                  CallLog[]
  moves                     DealMove[]
  demoBookings              DemoBooking[]
  closingEvents             ClosingEvent[]
  organizationLinks         DealOrganization[]
  offerNotifications        OfferNotification[]
  // Abonnements rattachés (1 à 3 par affaire). Les champs subscription* /
  // paymentMode / closingDate / dealValue ci-dessus sont conservés comme miroir
  // dénormalisé de l'abonnement principal (position 0) et de la somme des
  // valeurs, pour les cartes, totaux de colonnes et le dashboard.
  subscriptions             Subscription[]
  // Invitations « 2 CV de bouchers » envoyées à ce magasin.
  pvInvites                 PvInvite[]

  // Postgres n'indexe pas automatiquement les clés étrangères. Sans ces index,
  // charger un pipeline (GET /api/deals?pipelineId=…) balaie toute la table
  // des affaires puis la trie.
  @@index([pipelineId])
  @@index([columnId])
}

// Un abonnement vendu sur une affaire (jusqu'à 2 par deal). Chaque abonnement
// porte sa propre valeur, son type, son mode/cadence de paiement, sa date de
// closing et sa durée (→ date de fin calculée).
model Subscription {
  id                  String        @id @default(cuid())
  dealId              String
  deal                Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  position            Int           @default(0)
  value               Float?
  subscriptionType    String        @default("")
  paymentMode         String        @default("stripe")
  paymentTiming       String        @default("comptant")
  closingDate         DateTime?
  subscriptionMonths  Int           @default(12)
  subscriptionEndDate DateTime?
  // Qui a closé ce contrat. Choisi dans la liste déroulante de la pop-up
  // « Date de closing » (déplacement vers SMARTLINKÉ) : le closeur n'est pas
  // forcément celui qui déplace la carte, d'où le choix explicite. closedByName
  // est figé, comme partout ailleurs, pour que la statistique reste lisible si
  // le compte est renommé ou supprimé.
  closedByUserId      String?
  closedByUser        User?         @relation(fields: [closedByUserId], references: [id], onDelete: SetNull)
  closedByName        String        @default("")
  // CHURN : abonnement résilié. Quand true, la valeur de l'abonnement est
  // exclue du MRR et de toutes les autres données du Dashboard (route de closing
  // et analyses de l'assistant IA).
  churned             Boolean       @default(false)
  // Date de résiliation (churn), saisie via la pop-up au cochage de la case.
  // Sert à rattacher le client perdu à la bonne période pour le taux de churn.
  churnedAt           DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  // Trace du closing (table ClosingEvent) : au plus une ligne par abonnement,
  // créée quand sa date de closing est renseignée pour la première fois.
  closingEvent        ClosingEvent?

  @@index([dealId])
}

model JobOffer {
  id              String      @id @default(cuid())
  dealId          String
  deal            Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  storeId         String
  store           Store       @relation(fields: [storeId], references: [id])
  importBatchId   String
  importBatch     ImportBatch @relation(fields: [importBatchId], references: [id])
  externalOfferId String      @default("")
  title           String      @default("")
  jobTitle        String      @default("")
  contractType    String      @default("")
  salary          String      @default("")
  source          String      @default("")
  url             String      @default("")
  publishedAt     String      @default("")
  fingerprint     String      @unique
  firstSeenAt     DateTime    @default(now())
  lastSeenAt      DateTime    @default(now())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Les offres sont systématiquement lues par affaire (cartes du pipeline,
  // fiche affaire) : sans index, chaque chargement balaie toute la table.
  @@index([dealId])
  @@index([storeId])
}

model ImportBatch {
  id           String      @id @default(cuid())
  fileName     String
  importedAt   DateTime    @default(now())
  totalRows    Int         @default(0)
  createdDeals Int         @default(0)
  updatedDeals Int         @default(0)
  newOffers    Int         @default(0)
  movedToCall  Int         @default(0)
  errorCount   Int         @default(0)
  createdAt    DateTime    @default(now())
  importRows   ImportRow[]
  jobOffers    JobOffer[]
}

model ImportRow {
  id            String      @id @default(cuid())
  importBatchId String
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  rowNumber     Int
  rawData       Json
  status        String      @default("ok")
  errorMessage  String      @default("")
  storeId       String?
  store         Store?      @relation(fields: [storeId], references: [id])
  dealId        String?
  deal          Deal?       @relation(fields: [dealId], references: [id])
  createdAt     DateTime    @default(now())
}

model Action {
  id             String    @id @default(cuid())
  dealId         String
  deal           Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  title          String
  type           String    @default("Appeler")
  dueDate        DateTime  @db.Timestamptz
  dueTime        String    @default("")
  status         String    @default("todo")
  priority       String    @default("normale")
  note           String    @default("")
  completedAt    DateTime?
  assignedUserId String?
  assignedUser   User?     @relation(fields: [assignedUserId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Lues par affaire (prochaine action sur la carte) et par échéance
  // (page « Actions »).
  @@index([dealId])
  @@index([status, dueDate])
}

model Note {
  id         String   @id @default(cuid())
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  content    String
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id])
  authorName String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model EmailTemplate {
  id        String     @id @default(cuid())
  name      String
  subject   String     @default("")
  body      String     @default("")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  emailLogs EmailLog[]
}

// Journal des emails d'une affaire, dans les DEUX sens :
//   direction = "outbound" → email parti du CRM (ou d'une automatisation) ;
//   direction = "inbound"  → réponse reçue du contact, captée par Resend
//                            Inbound (cf. src/lib/emailReplies.ts).
model EmailLog {
  id          String         @id @default(cuid())
  dealId      String
  deal        Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  templateId  String?
  template    EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  // "outbound" (défaut, = tout l'historique existant) ou "inbound".
  direction   String         @default("outbound")
  // Expéditeur. Sur un email entrant, c'est le contact qui a répondu ; sur un
  // email sortant, l'adresse @swipelink.fr utilisée. Null sur l'historique
  // antérieur à ce champ.
  fromAddress String?
  to          String
  // Adresses en copie (Cc), séparées par des virgules. Null si aucune.
  cc          String?
  subject     String
  body        String
  // Sortant  : "scheduled" (programmé, pas encore parti) → "sending" (en cours
  //            d'envoi) → "sent" → "opened" ; "failed" si Resend a refusé.
  // Entrant  : "received".
  status      String         @default("sent")
  // Envoi programmé : heure visée. L'email est écrit en base dès la rédaction
  // et part au premier passage de /api/emails/send-scheduled postérieur à
  // cette date. Null pour un envoi immédiat.
  scheduledAt DateTime?
  // Id Resend de l'email (sortant ou entrant) — sert à la déduplication.
  resendId    String?
  // Message-ID RFC 5322 de l'email et, pour une réponse, celui du message
  // auquel elle répond. Permet de rattacher une réponse à son envoi.
  messageId   String?
  inReplyTo   String?
  openedAt    DateTime?
  // Date de l'événement : envoi pour un sortant, réception pour un entrant.
  sentAt      DateTime       @default(now())
  createdAt   DateTime       @default(now())

  // La frise de la fiche affaire lit tous les emails d'une affaire triés par
  // date : sans index, chaque ouverture balaie toute la table.
  @@index([dealId, sentAt])
  @@index([resendId])
  // Recherché à chaque réponse reçue : rattachement au fil (In-Reply-To /
  // References → messageId de l'envoi) et déduplication entre sources.
  @@index([messageId])
  // File des envois programmés, relevée à chaque passage du planificateur.
  @@index([status, scheduledAt])
}

// Suivi CRM des appels aux candidats affichés dans l'onglet « Recrutement ».
// candidateId = id du Candidate dans la base produit Supabase. La présence
// d'une ligne signifie « candidat appelé » pour ce deal (case cochée).
model CandidateCall {
  id          String   @id @default(cuid())
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  candidateId String
  calledAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([dealId, candidateId])
}

// Journal des déplacements d'affaires : une ligne à CHAQUE changement d'étape,
// qu'il vienne du drag & drop du pipeline, du sélecteur d'étape de la fiche ou
// d'un import automatique. Conserve le couple pipeline + colonne au départ ET à
// l'arrivée (un changement de pipeline est un déplacement comme un autre), plus
// l'auteur du mouvement.
//
// Les colonnes et pipelines sont référencés par id BRUT, sans clé étrangère, et
// doublés de leur nom figé au moment du déplacement : une étape renommée ou
// supprimée ne doit pas réécrire ni effacer l'historique.
model DealMove {
  id               String   @id @default(cuid())
  dealId           String
  deal             Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromColumnId     String?
  fromColumnTitle  String   @default("")
  fromPipelineId   String?
  fromPipelineName String   @default("")
  toColumnId       String?
  toColumnTitle    String   @default("")
  toPipelineId     String?
  toPipelineName   String   @default("")
  // Auteur du déplacement. Null pour les mouvements automatiques (import).
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName         String   @default("")
  // Origine : "pipeline" (drag & drop), "fiche" (sélecteur d'étape de la fiche
  // affaire) ou "import" (retour automatique en « À appeler », déplacement
  // demandé lors d'un import CSV).
  source           String   @default("pipeline")
  movedAt          DateTime @default(now())

  @@index([dealId, movedAt])
  @@index([movedAt])
  @@index([userId, movedAt])
}

// Historique des démos bookées : une ligne est créée à CHAQUE passage d'une
// affaire dans la colonne « DEMO PREVUE » du pipeline Closing. Même principe
// que le compteur d'appels (CallLog) : on ajoute, on n'écrase jamais — un
// rebooking crée une NOUVELLE ligne à côté de la précédente, ce qui permet de
// compter les démos bookées par utilisateur sur une période et de garder la
// trace des démos qui ont fini en no-show.
model DemoBooking {
  id           String    @id @default(cuid())
  dealId       String
  deal         Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  // Auteur du booking = utilisateur qui a déplacé l'affaire dans la colonne.
  // Null pour un déplacement automatique ou un compte supprimé depuis.
  userId       String?
  user         User?     @relation("DemoBookedBy", fields: [userId], references: [id], onDelete: SetNull)
  // Nom figé à l'enregistrement : la statistique reste lisible même si le
  // compte est renommé ou supprimé.
  userName     String    @default("")
  // Date à laquelle la démo a été bookée (= entrée dans la colonne).
  bookedAt     DateTime  @default(now())
  // Date de la démo elle-même. Photographiée à la création puis maintenue à
  // jour tant que la ligne est le booking le plus récent de l'affaire (la date
  // est souvent renseignée sur la fiche juste après le déplacement).
  demoDate     DateTime?
  // Case « NO SHOW » de la fiche affaire : le contact n'est pas venu.
  noShow       Boolean   @default(false)
  // Qui a FAIT la démo, et quand. Rempli au passage de l'affaire dans
  // « DEMO FAITE » ou « ABSENT DEMO » : celui qui déplace la carte est celui
  // qui était devant le client. Vide tant que la démo n'a pas eu lieu ; jamais
  // écrasé ensuite (un rebooking crée une nouvelle ligne, qui a son propre
  // dénouement). doneByName est figé, comme userName, pour que l'historique
  // reste lisible si le compte est renommé ou supprimé.
  doneByUserId String?
  doneByUser   User?     @relation("DemoDoneBy", fields: [doneByUserId], references: [id], onDelete: SetNull)
  doneByName   String    @default("")
  doneAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([dealId, bookedAt])
  @@index([bookedAt])
  @@index([userId, bookedAt])
}

// Historique des closings : une ligne est créée quand un abonnement est VALIDÉ
// avec une date de closing — que ce soit par la pop-up « Date de closing » au
// passage en « SMARTLINKÉ » ou par l'onglet Abonnement de la fiche. Même esprit
// que CallLog (appels) et DemoBooking (démos) : l'évènement est enregistré tel
// quel, avec son auteur et sa date, sans avoir à le reconstituer depuis les
// colonnes de Subscription.
//
// Une différence assumée avec les deux autres : au plus UNE ligne par
// abonnement (contrainte d'unicité). Un closing n'est pas un geste répétable
// comme un appel ou un rebooking — un second contrat est un second abonnement,
// donc une seconde ligne. Corriger après coup la date ou le closeur met à jour
// la ligne existante au lieu d'en ajouter une (sinon le même contrat compterait
// deux fois) ; effacer la date de closing supprime la ligne.
model ClosingEvent {
  id               String       @id @default(cuid())
  dealId           String
  deal             Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  // Abonnement closé. Obligatoire : c'est lui qui porte le contrat, et la ligne
  // n'a pas de sens sans lui — supprimer l'abonnement supprime donc l'évènement.
  subscriptionId   String       @unique
  subscription     Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  // Qui a closé : le closeur choisi dans la pop-up (ou corrigé sur la fiche),
  // pas l'utilisateur qui a déplacé la carte. Null pour un closing enregistré
  // sans closeur, ou dont le compte a été supprimé depuis. userName est figé à
  // l'enregistrement pour que la statistique reste lisible dans ces deux cas.
  userId           String?
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName         String       @default("")
  // Date du closing telle qu'elle a été saisie (date commerciale du contrat).
  closingDate      DateTime
  // Photographie de l'abonnement au moment du closing : évite de rejouer une
  // jointure pour lire un montant, et garde la trace de ce qui a été signé même
  // si l'abonnement est modifié ensuite.
  value            Float?
  subscriptionType String       @default("")
  // D'où vient l'enregistrement : "pipeline" (pop-up au passage en SMARTLINKÉ),
  // "fiche" (onglet Abonnement) ou "backfill" (reprise de l'historique).
  source           String       @default("pipeline")
  // Quand le closing a été enregistré dans le CRM. Distinct de closingDate, qui
  // est la date commerciale : c'est cet horodatage qui situe l'évènement dans
  // le fil d'activité de la fiche.
  recordedAt       DateTime     @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([dealId, closingDate])
  @@index([closingDate])
  @@index([userId, closingDate])
}

// Compteur d'appels : une ligne est créée à CHAQUE clic sur « Afficher le
// numéro » dans la fiche affaire, tant que le « mode prospection » (interrupteur
// en haut à droite de l'app) est activé. Sert à mesurer le nombre d'appels passés par
// utilisateur sur une période (semaine, quinzaine, mois…). Le nom de
// l'utilisateur est figé à l'enregistrement pour que la statistique reste
// lisible même si le compte est renommé ou supprimé.
model CallLog {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String   @default("")
  // Numéro affiché au moment du clic (trace de ce qui a été composé).
  phone     String   @default("")
  calledAt  DateTime @default(now())
  // Le décisionnaire a-t-il pu être joint lors de cet appel ? On passe toujours
  // par l'accueil du magasin avant de le demander : cette réponse distingue les
  // appels réellement utiles des simples passages par le standard.
  // Renseigné par la pop-up affichée 20 s après le clic sur « Afficher le
  // numéro » ; reste null tant que l'utilisateur n'a pas répondu.
  connected Boolean?
  // Détail de la réponse quand le décisionnaire n'a PAS été joint, choisi dans
  // la même pop-up : ABSENT (pas sur le magasin), REUNION (en réunion), REFUS
  // (a refusé de prendre l'appel). JOINT quand il a été contacté — redondant
  // avec connected = true, mais le calendrier de l'affaire lit ce seul champ.
  // Null pour les appels enregistrés avant cette question (ou sans réponse).
  outcome   String?

  @@index([calledAt])
  @@index([userId, calledAt])
  @@index([dealId])
}

// Organisations produit (Supabase) rattachées à un deal. Permet d'en lier
// plusieurs (en plus de Deal.supabaseOrganizationId issu du provisioning) et
// de les renseigner manuellement quand l'auto-rattachement par nom échoue.
model DealOrganization {
  id             String   @id @default(cuid())
  dealId         String
  deal           Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  organizationId String
  createdAt      DateTime @default(now())

  @@unique([dealId, organizationId])
}

// Trace CRM des offres créées côté produit (Supabase) par les Organizations
// rattachées à une affaire. Alimentée en LECTURE SEULE depuis Supabase (rien
// n'y est écrit) : à chaque relevé, les nouvelles offres de la table Offer
// (id, title, organization_id, created_at) sont enregistrées ici. Sert à trois
// usages : trace « Nouvelle offre créée » dans l'onglet Activité, point bleu sur
// la carte de l'affaire, et centre de notifications du pipeline. isRead distingue
// une offre nouvellement apparue (point bleu) d'une offre déjà acquittée.
model OfferNotification {
  id             String   @id @default(cuid())
  dealId         String
  deal           Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  organizationId String
  // Id de l'Offer dans Supabase produit (unique par offre).
  offerId        String
  offerTitle     String   @default("")
  // Date de publication de l'offre (Offer.created_at côté Supabase).
  offerCreatedAt DateTime
  // False = nouvelle offre non acquittée (déclenche point bleu + badge).
  isRead         Boolean  @default(false)
  // Date de découverte de l'offre côté CRM (relevé Supabase).
  createdAt      DateTime @default(now())

  @@unique([dealId, offerId])
  @@index([dealId])
}

// Réglages globaux de l'application (clé/valeur). Ex. « emailSignature » :
// signature HTML ajoutée automatiquement à tous les emails envoyés du CRM.
model AppSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

// Attribution des liens de paiement « classiques » aux cases du plan tarifaire.
//
// Le plan lui-même (7 offres × 2 jeux de tarifs × 3 modes de paiement = 42 cases)
// est décrit en dur dans src/lib/paymentLinkSlots.ts : il ne change pas au gré
// des données. Cette table dit seulement QUEL Payment Link Stripe occupe QUELLE
// case — c'est ce qu'on renseigne depuis Paramètres › Liens de paiement.
//
// Une case sans ligne ici est simplement vide (non sélectionnable côté affaire).
// Un lien Stripe actif qui n'occupe aucune case est un lien « spécial », créé
// pour un client donné : la distinction classique/spécial se déduit de cette
// table, il n'y a rien d'autre à cocher.
model PaymentLinkSlot {
  // Clé de la case, ex. « c1-mois/actuel/mensuel » (voir buildSlotKey).
  slotKey      String   @id
  // Id du Payment Link Stripe (plink_…). Volontairement NON unique : rien
  // n'interdit qu'un même lien serve deux cases (l'écran de paramétrage le
  // signale, mais ne le refuse pas).
  stripeLinkId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([stripeLinkId])
}

// ─── Réception automatique des offres (N8N → CRM) ────────────────────────────
//
// Une automatisation externe (N8N) pousse ses offres sur
// POST /api/webhooks/job-offers?token=…  Elles n'entrent PAS directement dans
// le pipeline : elles atterrissent dans cette « boîte de réception », et c'est
// depuis le CRM qu'on choisit lesquelles importer (popup « Nouvelles offres
// reçues »). Les offres cochées passent ensuite par l'import normal — mêmes
// règles que le CSV (dédup magasin, nouvelle offre → retour en « À appeler ») ;
// les autres sont écartées et ne réapparaissent plus.
//
// Un lot = un envoi de l'automatisation.
model OfferInbox {
  id            String       @id @default(cuid())
  // Libellé lisible du lot, affiché dans la popup (ex. « Indeed — 12/03 »).
  label         String       @default("")
  // Origine annoncée par l'automatisation (ex. « n8n-indeed »).
  source        String       @default("")
  receivedAt    DateTime     @default(now())
  // Compteurs figés à la réception (le détail vit dans InboxOffer).
  totalRows     Int          @default(0)
  newRows       Int          @default(0)
  // Lignes ignorées à la réception car déjà présentes dans la boîte.
  duplicateRows Int          @default(0)
  // pending  = au moins une offre reste à trier
  // processed = lot tranché (offres importées et/ou écartées)
  status        String       @default("pending")
  processedAt   DateTime?
  processedBy   String       @default("")
  // Batch d'import créé lorsque des offres du lot ont été importées.
  importBatchId String?
  offers        InboxOffer[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, receivedAt])
}

// Une offre reçue, en attente d'arbitrage. Les colonnes reprennent les champs
// métier de l'import CSV (cf. MappedRow) pour pouvoir afficher la ligne dans la
// popup sans re-parser `rawData`, qui garde la charge utile d'origine.
model InboxOffer {
  id              String     @id @default(cuid())
  inboxId         String
  inbox           OfferInbox @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  rawData         Json
  brand           String     @default("")
  storeName       String     @default("")
  city            String     @default("")
  postalCode      String     @default("")
  department      String     @default("")
  address         String     @default("")
  jobTitle        String     @default("")
  offerTitle      String     @default("")
  contractType    String     @default("")
  salary          String     @default("")
  source          String     @default("")
  url             String     @default("")
  publishedAt     String     @default("")
  externalOfferId String     @default("")
  // Clé de déduplication À LA RÉCEPTION : une offre déjà reçue (peu importe
  // qu'elle ait été importée, écartée ou qu'elle attende encore) n'est pas
  // reproposée. Calculée sans identifiant de magasin, celui-ci pouvant ne pas
  // exister encore en base (cf. buildInboxOfferKey).
  receptionKey    String     @unique
  // Clé de dédup magasin (cf. buildDeduplicationKey), pour information.
  storeKey        String     @default("")
  // Renseignés à la réception, pour aider au tri :
  //   knownStore = le magasin est déjà suivi dans le CRM
  //   knownOffer = cette offre précise a déjà été importée (doublon)
  knownStore      Boolean    @default(false)
  knownOffer      Boolean    @default(false)
  existingDealId  String?
  // pending | imported | rejected
  status          String     @default("pending")
  decidedAt       DateTime?
  decidedBy       String     @default("")
  createdAt       DateTime   @default(now())

  @@index([inboxId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════════════
//  OUTIL CAMPAGNES — séquences d'emails (onglet « Campagnes »)
// ═══════════════════════════════════════════════════════════════════════════
//
// Étape 1 du chantier : les boîtes d'envoi et les leads. Les campagnes et
// séquences proprement dites arrivent à l'étape suivante et viendront se
// greffer sur ces deux socles.
//
// Principe général : le CRM n'envoie PAS par un routeur transactionnel (Resend)
// mais directement depuis de vraies boîtes (Google Workspace, OVH), en SMTP.
// Les réponses sont relevées en IMAP sur ces mêmes boîtes — exactement comme
// le relevé déjà en place pour les affaires (cf. src/lib/emailInbox.ts), mais
// paramétré en base plutôt qu'en variables d'environnement, pour qu'une
// nouvelle adresse s'ajoute depuis l'interface sans redéploiement.

// Une boîte d'envoi : les identifiants SMTP (départ) et IMAP (réponses) d'une
// adresse réelle, plus ses garde-fous d'envoi (quota, délais, plage horaire).
//
// Les mots de passe sont chiffrés en base (AES-256-GCM, cf.
// src/lib/campaigns/crypto.ts) et ne ressortent JAMAIS par l'API.
model Mailbox {
  id          String @id @default(cuid())
  // Adresse réelle de la boîte — sert d'identité et d'expéditeur.
  email       String @unique
  // Nom affiché par le destinataire : « Bilal Yacouti - Swipelink ».
  displayName String @default("")
  // « google » (Google Workspace / Gmail), « ovh » (MX Plan) ou « custom ».
  // Ne sert qu'à pré-remplir les serveurs : le fonctionnement est identique.
  provider    String @default("custom")

  // ─── SMTP : le départ des emails ───────────────────────────────────────
  smtpHost   String
  smtpPort   Int     @default(465)
  // true = TLS implicite (port 465) ; false = STARTTLS (port 587).
  smtpSecure Boolean @default(true)
  // Identifiant SMTP, en pratique l'adresse elle-même.
  smtpUser   String
  // Mot de passe d'application (Google) ou mot de passe de la boîte (OVH),
  // chiffré. Jamais renvoyé au client.
  smtpSecret String

  // ─── IMAP : la détection des réponses ──────────────────────────────────
  // Facultatif : sans IMAP, la boîte envoie mais l'arrêt automatique sur
  // réponse ne peut pas fonctionner pour elle (on le signale dans l'interface).
  imapHost     String?
  imapPort     Int     @default(993)
  imapUser     String?
  // Vide = mêmes identifiants que le SMTP (cas le plus courant).
  imapSecret   String?
  imapFolder   String  @default("INBOX")
  // Curseur de relevé : dernier UID traité dans le dossier surveillé. Évite de
  // relire toute la boîte à chaque passage.
  imapCursor   Int?
  imapValidity Int? // UIDVALIDITY : s'il change, le curseur est rejoué à zéro

  // ─── Garde-fous d'envoi (anti-spam / réputation) ───────────────────────
  // Nombre maximal d'emails partant de cette boîte par jour.
  dailyLimit      Int       @default(80)
  // Espacement aléatoire entre deux envois, en secondes : le moteur tire une
  // valeur entre les deux bornes pour ne pas produire de cadence mécanique.
  minDelaySec     Int       @default(90)
  maxDelaySec     Int       @default(300)
  // Plage horaire d'envoi (heures locales du fuseau ci-dessous) et jours
  // autorisés au format ISO (1 = lundi … 7 = dimanche).
  sendStartHour   Int       @default(8)
  sendEndHour     Int       @default(19)
  sendDays        String    @default("1,2,3,4,5")
  timezone        String    @default("Europe/Paris")
  // Montée en charge : plafond du premier jour, augmenté chaque jour de
  // `warmupStep` jusqu'à `dailyLimit`. 0 = pas de montée en charge.
  warmupStart     Int       @default(0)
  warmupStep      Int       @default(5)
  warmupStartedAt DateTime?

  // Signature HTML ajoutée en bas des emails partis de cette boîte.
  signatureHtml String?

  // Une boîte inactive n'envoie plus et n'est plus relevée, sans être perdue.
  active      Boolean   @default(true)
  // Dernier test de connexion : date et message d'erreur éventuel. Affichés
  // dans l'interface pour qu'un mot de passe expiré se voie tout de suite.
  lastCheckAt DateTime?
  lastCheckOk Boolean?
  lastError   String?
  lastSyncAt  DateTime?

  // Espacement des envois : heure à partir de laquelle cette boîte peut
  // renvoyer. Tenue par le moteur, qui tire un délai aléatoire après chaque
  // envoi — deux passages simultanés ne peuvent donc pas doubler la cadence.
  nextSendAt DateTime?

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  campaigns   CampaignMailbox[]
  enrollments CampaignEnrollment[]
  messages    CampaignMessage[]
  replies     CampaignReply[]

  @@index([active])
}

// Un lead prospecté par l'outil Campagnes.
//
// Volontairement indépendant de `Deal` : un lead est un contact froid, il n'a
// rien à faire dans le pipeline tant qu'il n'a pas manifesté d'intérêt. Le
// champ `dealId` est réservé au rattachement au CRM (bouton « convertir en
// affaire »), qui sera branché dans un second temps.
model Lead {
  id    String @id @default(cuid())
  // Seul champ obligatoire. Normalisé en minuscules : c'est la clé de
  // déduplication entre deux imports.
  email String @unique

  // Champs usuels, tous facultatifs. Ils alimentent les variables de
  // personnalisation ({{prenom}}, {{enseigne}}…) dans les emails.
  civility       String?
  firstName      String?
  lastName       String?
  // Interlocuteur appelé côté CRM (« Contact calling » de la fiche affaire) :
  // souvent un prénom + nom saisi pendant la prospection téléphonique. Repris
  // ici pour être utilisable en variable {{contact_calling}} et rester
  // synchronisé avec l'affaire.
  contactCalling String?
  jobTitle       String?
  company        String? // enseigne / société
  phone          String?
  website        String?
  city           String?
  country        String?
  // Toutes les autres colonnes du fichier importé, telles quelles :
  // { "effectif": "12", "ca": "1.4M" }. Utilisables comme variables.
  customFields   Json    @default("{}")

  // Cycle de vie commercial, piloté à la main depuis la fiche lead :
  //   new · contacted · replied · interested · not_interested ·
  //   unsubscribed · bounced · customer
  status   String    @default("new")
  statusAt DateTime?
  // Utilisateur du CRM à qui le lead est attribué (facultatif).
  ownerId  String?
  owner    User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  // Provenance : lot d'import ou saisie manuelle.
  source   String?
  importId String?
  import   LeadImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  // Rattachement à l'affaire du CRM dont le lead vient (cf. crmLink.ts) :
  // il porte la liaison bidirectionnelle des champs de contact et sert au
  // filtre par pipeline / étape de l'écran Leads.
  dealId String?

  // Jalons entretenus par le moteur d'envoi (étape 2) et par les actions
  // manuelles. Dénormalisés ici pour que les listes restent rapides.
  lastContactedAt DateTime?
  lastOpenedAt    DateTime?
  lastRepliedAt   DateTime?
  unsubscribedAt  DateTime?
  bouncedAt       DateTime?

  notes       LeadNote[]
  events      LeadEvent[]
  enrollments CampaignEnrollment[]
  messages    CampaignMessage[]
  replies     CampaignReply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Listes filtrées par statut et triées par date : l'index évite un balayage
  // complet dès que la base dépasse quelques milliers de leads.
  @@index([status, createdAt])
  @@index([importId])
  @@index([company])
  // Filtre « pipeline / étape » de l'écran Leads : il ramène les leads d'une
  // liste d'affaires, donc une recherche par dealId.
  @@index([dealId])
}

// Un lot d'import de leads (un fichier CSV déposé dans l'interface).
model LeadImport {
  id        String   @id @default(cuid())
  filename  String
  // Correspondance colonne du fichier → champ du lead, telle qu'elle a été
  // validée à l'écran. Conservée pour pouvoir rejouer ou auditer un import.
  mapping   Json     @default("{}")
  total     Int      @default(0)
  created   Int      @default(0)
  updated   Int      @default(0)
  skipped   Int      @default(0)
  // Nom de l'utilisateur qui a lancé l'import (identité locale du CRM).
  userName  String?
  createdAt DateTime @default(now())

  leads Lead[]
}

// Note libre saisie sur la fiche d'un lead.
model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userName  String?
  body      String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

// Frise d'activité d'un lead : import, changement de statut, note, envoi,
// ouverture, réponse, désinscription… Tout ce que la fiche doit raconter.
model LeadEvent {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // imported · status_changed · note_added · updated · email_sent ·
  // email_opened · replied · unsubscribed · bounced · enrolled · stopped
  type      String
  label     String   @default("")
  payload   Json?
  userName  String?
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

// ─── Campagnes : séquences, inscriptions, messages ─────────────────────────
//
// Étape 2 du chantier. Le vocabulaire :
//   • Campaign   — une séquence, ses réglages et ses boîtes d'envoi ;
//   • CampaignStep — une étape de la séquence (un email + son délai d'attente) ;
//   • Enrollment — UN lead DANS une campagne. C'est l'objet que l'on arrête
//     individuellement : stopper un lead ne touche pas les autres ;
//   • CampaignMessage — un email réellement parti (ou en échec), qui porte le
//     suivi d'ouverture.
//
// Le moteur (src/lib/campaigns/engine.ts) ne regarde jamais une campagne dans
// son ensemble : il relève les inscriptions dont l'heure est venue, boîte par
// boîte, en respectant les garde-fous de chacune.

model Campaign {
  id          String @id @default(cuid())
  name        String
  description String @default("")
  // draft (jamais lancée) · running · paused · finished · archived
  status      String @default("draft")

  // Arrêt automatique de la séquence dès qu'un lead répond. C'est le
  // comportement attendu d'un outil de prospection ; désactivable au cas où.
  stopOnReply    Boolean @default(true)
  // Pixel de suivi d'ouverture. Les liens ne sont pas réécrits (pas de suivi
  // de clic) : les emails restent propres pour la délivrabilité.
  trackOpens     Boolean @default(true)
  // Lien de désinscription ajouté en bas de chaque email + en-tête
  // List-Unsubscribe. Vivement conseillé en prospection à froid.
  addUnsubscribe Boolean @default(true)

  steps         CampaignStep[]
  mailboxes     CampaignMailbox[]
  enrollments   CampaignEnrollment[]
  messages      CampaignMessage[]
  // Règles qui inscrivent automatiquement dans cette campagne (cf. OfferTrigger).
  offerTriggers OfferTrigger[]

  userName   String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
}

// Boîtes utilisées par une campagne. Plusieurs boîtes = rotation : chaque lead
// reçoit toute la séquence depuis UNE seule d'entre elles (le fil reste
// cohérent), mais le volume se répartit entre elles.
model CampaignMailbox {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  mailboxId  String
  mailbox    Mailbox  @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([campaignId, mailboxId])
}

// Une étape de la séquence : le délai d'attente, puis l'email.
model CampaignStep {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // Rang dans la séquence, à partir de 1.
  position   Int
  // Attente AVANT cette étape, comptée depuis l'envoi précédent (0 pour la
  // première, qui part dès l'inscription). En heures : « 3 jours » = 72.
  delayHours Int      @default(0)

  subject       String  @default("")
  // Deux corps : le texte simple (converti en HTML sobre à l'envoi, le plus
  // sûr pour la délivrabilité) et le HTML libre pour un email commercial.
  // `useHtml` dit lequel part réellement.
  bodyText      String  @default("")
  bodyHtml      String  @default("")
  useHtml       Boolean @default(false)
  // Relance dans le MÊME fil que l'email précédent (« Re: … », en-têtes
  // In-Reply-To / References). Décoché : nouvel email indépendant.
  replyToThread Boolean @default(true)

  /// Modèle fourni par le CRM, au lieu du corps rédigé ci-dessus.
  ///
  /// Vide = étape libre, le cas courant. « boucher » = invitation « 2 CV de
  /// bouchers » : le sujet et le corps viennent du modèle du pilote, et
  /// surtout le moteur CRÉE UN JETON pour l'affaire du lead au moment de
  /// l'envoi. C'est ce que ne peut pas faire une étape libre — un jeton est une
  /// ligne en base rattachée à une affaire, pas un remplacement de texte.
  ///
  /// Un lead sans affaire rattachée ne peut pas recevoir cette étape : il est
  /// écarté de la séquence avec un motif lisible plutôt que de recevoir un mail
  /// dont le bouton n'ouvre rien.
  templateKey String @default("")

  messages  CampaignMessage[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([campaignId, position])
}

// Un lead inscrit dans une campagne : l'unité de pilotage du moteur.
model CampaignEnrollment {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // active · paused · finished · stopped
  status     String  @default("active")
  // Pourquoi l'inscription s'est arrêtée : replied · manual · unsubscribed ·
  // bounced · failed · completed. Affiché tel quel dans la fiche campagne.
  stopReason String?

  // Nombre d'étapes déjà envoyées (0 = rien n'est encore parti).
  sentSteps  Int       @default(0)
  // Heure du prochain envoi. C'est LE champ que relève le moteur.
  nextSendAt DateTime?

  // Boîte affectée à ce lead, tirée à l'inscription et conservée : toute la
  // séquence part de la même adresse, sinon le fil de discussion se casse.
  mailboxId       String?
  mailbox         Mailbox? @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  // Message-ID et sujet du premier email : servent à accrocher les relances
  // au même fil de discussion.
  threadMessageId String?
  threadSubject   String?

  messages CampaignMessage[]

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Un lead ne peut être inscrit qu'une fois dans une même campagne.
  @@unique([campaignId, leadId])
  // File du moteur : « les inscriptions actives dont l'heure est venue ».
  @@index([status, nextSendAt])
  @@index([campaignId, status])
}

// Un email de campagne réellement parti (ou tenté).
model CampaignMessage {
  id           String             @id @default(cuid())
  campaignId   String
  campaign     Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   CampaignEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepId       String?
  step         CampaignStep?      @relation(fields: [stepId], references: [id], onDelete: SetNull)
  leadId       String
  lead         Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  mailboxId    String?
  mailbox      Mailbox?           @relation(fields: [mailboxId], references: [id], onDelete: SetNull)

  stepPosition Int     @default(1)
  // sent · failed
  status       String  @default("sent")
  toAddress    String
  fromAddress  String
  subject      String
  bodyHtml     String
  // Message-ID RFC 5322 de l'email envoyé : point d'accroche des relances ET
  // du rattachement des réponses.
  messageId    String?
  error        String?

  // Suivi d'ouverture : identifiant du pixel (jamais l'id du message, qui ne
  // doit pas circuler dans une URL publique).
  trackingId String    @unique @default(cuid())
  openedAt   DateTime?
  openCount  Int       @default(0)
  repliedAt  DateTime?

  sentAt DateTime @default(now())

  // Tableaux de bord : « les messages d'une campagne sur une période ».
  @@index([campaignId, sentAt])
  @@index([messageId])
  @@index([leadId])
}

// Une réponse reçue sur une boîte d'envoi, relevée en IMAP.
// Conservée telle quelle : c'est la preuve de l'arrêt d'une séquence, et
// l'extrait s'affiche dans la fiche du lead.
model CampaignReply {
  id         String   @id @default(cuid())
  mailboxId  String?
  mailbox    Mailbox? @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId String?

  fromAddress String
  subject     String   @default("")
  snippet     String   @default("")
  messageId   String?
  inReplyTo   String?
  receivedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  // Déduplication entre deux relevés.
  @@unique([mailboxId, messageId])
  @@index([leadId, receivedAt])
}

// ─── Déclencheurs sur offres d'emploi ────────────────────────────────────
//
// « Quand une offre de boucher sort sur une affaire, inscris son contact dans
// la campagne dédiée aux bouchers. »
//
// Les offres relevées par l'import (JobOffer) disent ce que le magasin
// recherche AUJOURD'HUI. C'est le meilleur moment pour l'aborder, et le sujet
// de l'email dépend du métier recherché : une règle relie donc un intitulé
// d'offre à une campagne.
//
// Deux garde-fous portés par le modèle :
//   • une règle ne regarde que les offres apparues APRÈS elle (`since`), pour
//     qu'activer une règle ne déclenche pas un envoi sur tout l'historique ;
//   • chaque correspondance est enregistrée (OfferTriggerHit) avec une
//     contrainte d'unicité : une offre n'inscrit jamais deux fois.
model OfferTrigger {
  id         String   @id @default(cuid())
  name       String
  // Termes cherchés dans l'intitulé de l'offre, séparés par des virgules ou
  // des retours à la ligne. Comparaison sans casse ni accent, en début de mot
  // (« boucher » trouve boucher, bouchère, boucherie).
  keywords   String   @default("")
  // Termes qui annulent la correspondance (« apprenti », « alternance »).
  exclude    String   @default("")
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // Une règle en pause ne déclenche plus rien, sans être perdue.
  active     Boolean  @default(true)

  // Périmètre facultatif : n'agir que sur un pipeline et/ou une enseigne.
  pipelineId String?
  brandId    String?

  // Plancher temporel : les offres relevées avant cette date sont ignorées.
  // Posé à la création ; la reprise de l'historique le recule explicitement.
  since DateTime @default(now())

  lastRunAt     DateTime?
  matchedCount  Int       @default(0)
  enrolledCount Int       @default(0)

  hits      OfferTriggerHit[]
  userName  String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([active])
}

// Une offre déjà passée devant une règle, et ce qui en est sorti.
//
// La ligne est écrite même quand rien n'a pu être inscrit (pas d'adresse, lead
// désinscrit…) : c'est ce qui rend le déclencheur explicable, et c'est aussi ce
// qui garantit qu'on ne réessaiera pas indéfiniment la même offre.
model OfferTriggerHit {
  id         String       @id @default(cuid())
  triggerId  String
  trigger    OfferTrigger @relation(fields: [triggerId], references: [id], onDelete: Cascade)
  jobOfferId String
  dealId     String
  leadId     String?
  // enrolled · lead_created · skipped · failed
  outcome    String
  // Pourquoi, quand ce n'est pas une inscription.
  reason     String       @default("")
  // Recopiés pour que le journal reste lisible même si l'offre disparaît.
  offerTitle String       @default("")
  storeName  String       @default("")
  createdAt  DateTime     @default(now())

  // Une offre ne déclenche qu'une fois par règle.
  @@unique([triggerId, jobOfferId])
  @@index([triggerId, createdAt])
}

// ─── Pilote « Prospection de Valeur » : parcours boucher ──────────────────────
//
// Un magasin publie une offre de boucher → son directeur reçoit un mail dont
// l'unique bouton ouvre rdv.swipelink.fr/boucher?t=<jeton>. Sur cette page il
// répond à trois questions et réserve une démo de 15 min en visio.
//
// Trois tables portent tout le parcours :
//   PvInvite  — l'invitation d'un magasin : le jeton, sa validité, et ce que le
//               directeur a répondu ;
//   PvBooking — la démo réservée, et le VERROU qui interdit deux réservations
//               sur le même créneau ;
//   PvEvent   — l'entonnoir, anonyme, qui dit où les gens s'arrêtent.

/// Invitation envoyée à un magasin, identifiée par un jeton à usage unique.
///
/// Le jeton n'est JAMAIS stocké en clair : seul son empreinte SHA-256 vit ici
/// (`tokenHash`). Une fuite de la base ne permet donc pas de rouvrir les pages
/// des magasins. L'URL, elle, ne contient aucune donnée personnelle — juste le
/// jeton, qui ne dit rien de qui le porte.
model PvInvite {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  /// SHA-256 (hexadécimal) du jeton envoyé dans l'URL. Clé de recherche : la
  /// résolution d'un jeton est un seul accès par index, sans déchiffrement.
  tokenHash   String    @unique
  /// Le même jeton, CHIFFRÉ (AES-256-GCM, clé CAMPAIGN_SECRET_KEY — cf.
  /// src/lib/campaigns/crypto.ts).
  ///
  /// Pourquoi le garder alors que l'empreinte suffit à ouvrir la page : parce
  /// qu'un rappel ou une relance doit contenir un lien QUI MARCHE, et que le
  /// lien déjà envoyé (mail, invitation d'agenda) doit continuer de marcher.
  /// Sans cette copie, la seule solution serait d'émettre un nouveau jeton à
  /// chaque envoi, ce qui casserait le lien « Déplacer le rendez-vous » posé
  /// dans l'agenda du directeur.
  ///
  /// La clé vit dans l'environnement, jamais en base : qui lirait la table
  /// n'obtiendrait toujours aucun jeton utilisable. Vide si le chiffrement
  /// n'est pas configuré — on retombe alors sur l'émission d'un jeton neuf.
  tokenCipher String    @default("")
  expiresAt   DateTime
  /// Renseignée quand l'invitation est retirée à la main (désinscription,
  /// erreur d'envoi). Un jeton révoqué est traité comme expiré.
  revokedAt   DateTime?

  /// Nombre de profils annoncé. FIGÉ à la création : le mail et la page doivent
  /// afficher le même nombre, aujourd'hui comme dans trois semaines.
  nbProfils Int @default(0)

  /// Envoi du mail : date de départ et identifiant du message.
  sentAt    DateTime?
  messageId String    @default("")

  // ─── Réponses du parcours (remplies au fil des écrans) ────────────────────
  experience     String    @default("")
  salaire        String    @default("")
  salaireType    String    @default("")
  priseDePoste   String    @default("")
  /// Adresse validée à l'écran 4 (celle du magasin, ou celle qu'il a corrigée).
  email          String    @default("")
  emailCorrected Boolean   @default(false)
  cguAcceptedAt  DateTime?

  /// Demande de rappel (« aucun créneau ne me convient »).
  callbackPhone String    @default("")
  callbackAt    DateTime?

  /// Relance J+1 des parcours commencés sans réservation : date d'envoi, pour
  /// ne relancer qu'une fois.
  followUpAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking PvBooking?
  events  PvEvent[]

  @@index([dealId])
  @@index([expiresAt])
}

/// Démo réservée depuis le parcours.
///
/// LE VERROU DES CRÉNEAUX : `slotKey` porte l'heure de début du créneau et est
/// UNIQUE. Deux réservations simultanées sur le même créneau ne peuvent donc pas
/// aboutir toutes les deux — la seconde viole la contrainte et reçoit un 409.
/// C'est la base qui tranche, pas un « lire puis écrire » applicatif, qui
/// laisserait passer les deux dans l'intervalle.
///
/// Une démo déplacée ou annulée doit libérer son créneau sans perdre sa trace :
/// on remplace alors `slotKey` par « libre:<id> », valeur unique qui ne
/// correspond à aucun créneau. (Postgres sait faire un index unique partiel,
/// mais Prisma ne sait pas le décrire : cette astuce obtient la même garantie
/// dans le schéma lui-même.)
model PvBooking {
  id       String   @id @default(cuid())
  inviteId String   @unique
  invite   PvInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  dealId   String

  /// Début du créneau en clé unique (ISO-8601, ex. « 2026-09-24T09:00:00.000Z »),
  /// ou « libre:<id> » quand la réservation ne tient plus le créneau.
  slotKey String   @unique
  startAt DateTime
  endAt   DateTime

  /// booked · cancelled
  status String @default("booked")

  googleEventId String @default("")
  meetUrl       String @default("")

  /// Rappels déjà partis (la veille, puis 1 h avant) : une date renseignée vaut
  /// « déjà envoyé », ce qui rend le passage du planificateur rejouable.
  remindedDayBeforeAt  DateTime?
  remindedHourBeforeAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startAt])
  @@index([dealId])
  @@index([status, startAt])
}

/// Étape franchie dans le parcours (page_view, answer_1..3, email_edit,
/// slot_select, booking_ok, booking_err, callback_open, callback_ok).
///
/// Anonyme : aucune donnée personnelle, seulement l'invitation concernée et
/// l'instant. Sert à deux choses — mesurer où l'on perd les directeurs, et
/// savoir qui relancer le lendemain. La relance se fonde sur les `answer_*` et
/// JAMAIS sur l'ouverture du mail : les Safe Links de Microsoft cliquent les
/// liens à la place du destinataire, un simple clic ne prouve donc rien.
model PvEvent {
  id         String   @id @default(cuid())
  inviteId   String
  invite     PvInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  event      String
  step       Int      @default(0)
  /// Instant vécu côté navigateur (peut différer de createdAt si l'envoi a
  /// traîné — sendBeacon part parfois à la fermeture de l'onglet).
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([inviteId, createdAt])
  @@index([event, createdAt])
}
