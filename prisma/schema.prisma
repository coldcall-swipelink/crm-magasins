generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stores    Store[]
}

model Store {
  id               String   @id @default(cuid())
  brandId          String?
  brand            Brand?   @relation(fields: [brandId], references: [id])
  name             String
  normalizedName   String
  city             String   @default("")
  postalCode       String   @default("")
  department       String   @default("")
  address          String   @default("")
  phone            String   @default("")
  email            String   @default("")
  siret            String   @default("")
  externalId       String   @default("")
  deduplicationKey String   @unique
  // Coordonnées GPS issues du géocodage de l'adresse (API BAN data.gouv).
  // Mises en cache pour éviter de re-géocoder à chaque ouverture de la carte.
  latitude         Float?
  longitude        Float?
  geocodedAt       DateTime?
  geocodeQuery     String   @default("")
  // ── Recherche automatique du numéro de téléphone (cf. src/lib/phone) ──
  // Le numéro du magasin est retrouvé sur OpenStreetMap puis, à défaut, sur la
  // fiche Google de l'établissement. Ces colonnes gardent la trace de la
  // recherche pour ne jamais la refaire inutilement et pour pouvoir arbitrer
  // les cas douteux depuis l'interface.
  //   phoneSource       : "osm" | "google" | "manuel" | "import"
  //   phoneLookupStatus : "" (jamais cherché) | "trouve" | "a_verifier"
  //                       | "introuvable" | "erreur"
  //   phoneCandidates   : numéros proposés + indices de correspondance, servant
  //                       à la file de revue (statut "a_verifier").
  phoneSource       String   @default("")
  phoneLookupStatus String   @default("")
  phoneLookupAt     DateTime?
  phoneCandidates   Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deal             Deal?
  jobOffers        JobOffer[]
  importRows       ImportRow[]

  @@index([phoneLookupStatus])
}

model Collaborator {
  id        String   @id @default(cuid())
  name      String
  email     String   @default("")
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deals     Deal[]
}

// Liste configurable (Paramètres) des types d'abonnement sélectionnables sur
// la fiche affaire (onglet « Abonnement »). Le deal stocke le nom choisi.
model SubscriptionType {
  id        String   @id @default(cuid())
  name      String   @unique
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Utilisateur de l'application (identité choisie à la première connexion,
// stockée côté navigateur). Complémentaire de Collaborator : sert à savoir
// qui est connecté, qui suit un deal, à qui une action est assignée et qui
// rédige une note.
model User {
  id              String   @id @default(cuid())
  name            String   @unique
  // Identifiants de connexion. Optionnels pour ne pas casser les utilisateurs
  // historiques créés à la volée (assignation d'affaires) sans compte : seuls
  // les comptes disposant d'un email + passwordHash peuvent se connecter.
  email           String?  @unique
  passwordHash    String?  // hash scrypt « salt:hash » — jamais renvoyé au client
  color           String   @default("#6366f1")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  assignedDeals   Deal[]
  assignedActions Action[]
  authoredNotes   Note[]
  callLogs        CallLog[]
  dealMoves       DealMove[]
  demoBookings    DemoBooking[]
}

model Pipeline {
  id        String   @id @default(cuid())
  name      String   @unique
  position  Int      @default(0)
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  columns   PipelineColumn[]
  deals     Deal[]
}

model PipelineColumn {
  id         String   @id @default(cuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  title      String
  position   Int
  color      String   @default("#6366f1")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  deals      Deal[]
}

model Deal {
  id                        String   @id @default(cuid())
  pipelineId                String
  pipeline                  Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  storeId                   String   @unique
  store                     Store    @relation(fields: [storeId], references: [id])
  columnId                  String
  column                    PipelineColumn @relation(fields: [columnId], references: [id])
  previousColumnId          String?
  // Regroupement d'affaires : un « gros » deal peut en absorber d'autres
  // (autres magasins d'un même groupe). Un sous-deal disparaît du pipeline et
  // reste accessible via son parent ou la recherche. Limité à un seul niveau.
  parentDealId              String?
  parentDeal                Deal?    @relation("DealHierarchy", fields: [parentDealId], references: [id], onDelete: SetNull)
  childDeals                Deal[]   @relation("DealHierarchy")
  priority                  String   @default("normale")
  // Tag commercial : true = Prospection de Valeur (PV), false = Prospection
  // Classique (PC). Affiché sous forme de puce à cocher sur chaque affaire.
  isPV                      Boolean  @default(true)
  // Mode de paiement choisi pour les affaires en étape « SMARTLINKÉ » :
  // "stripe" (par défaut) ou "virement". Affiché sous forme d'interrupteur sur
  // la fiche affaire uniquement quand l'affaire est dans cette étape.
  paymentMode               String   @default("stripe")
  position                  Int      @default(0)
  isNewFromLastImport       Boolean  @default(false)
  hasNewOfferFromLastImport Boolean  @default(false)
  isPresentInLastImport     Boolean  @default(true)
  movedToCallAt             DateTime?
  lastImportAt              DateTime?
  directeur                 String   @default("")
  contactCalling            String   @default("")
  dealEmail                 String   @default("")
  contactCivilite           String   @default("Monsieur")
  contactLastName           String   @default("")
  // Numéro de téléphone du contact, saisi manuellement sur la fiche affaire.
  // Masqué par défaut : il faut cliquer sur « Afficher le numéro » pour le
  // dévoiler, et ce clic est comptabilisé comme un appel (cf. CallLog).
  contactPhone              String   @default("")
  dealValue                 Float?
  demoDate                  DateTime?
  // Date du DERNIER booking de démo (dernière entrée dans « DEMO PREVUE » du
  // pipeline Closing). Simple miroir dénormalisé de la ligne DemoBooking la
  // plus récente, conservé pour les lectures rapides ; l'historique complet
  // (un rebooking = une ligne de plus) vit dans DemoBooking.
  demoBookedAt              DateTime?
  candidateCallDate         DateTime?
  // Date de closing : renseignée à l'entrée dans l'étape « SMARTLINKÉ »
  // (demandée au drag & drop) et modifiable depuis l'onglet « Abonnement ».
  closingDate               DateTime?
  // ----- Abonnement (onglet « Abonnement » de la fiche affaire) -----
  // Nom du type d'abonnement choisi (liste configurable dans Paramètres).
  subscriptionType          String   @default("")
  // Cadence de paiement : "comptant" (par défaut) ou "mensuel".
  paymentTiming             String   @default("comptant")
  // Durée totale de l'abonnement en mois (1 an = 12 par défaut).
  subscriptionMonths        Int      @default(12)
  // Date de fin calculée automatiquement = closingDate + subscriptionMonths.
  subscriptionEndDate       DateTime?
  googleEventId             String?
  googleMeetUrl             String?
  // Id de l'Organization créée dans la base produit Supabase quand l'affaire
  // passe en « Démo prévue » (garantit l'idempotence du provisioning).
  supabaseOrganizationId    String?
  // True quand l'utilisateur a géré manuellement les organisations rattachées :
  // on n'exécute alors plus le rattachement automatique par nom.
  supabaseOrgManual         Boolean  @default(false)
  // Date du premier relevé des offres produit (Supabase) rattachées à l'affaire.
  // Sert de ligne de base : les offres déjà présentes lors de ce premier relevé
  // sont marquées « lues » (pré-existantes) ; seules les offres créées ENSUITE
  // déclenchent point bleu + notification + trace d'activité. Null = jamais relevé.
  offersSyncedAt            DateTime?
  collaboratorId            String?
  collaborator              Collaborator? @relation(fields: [collaboratorId], references: [id])
  assignedUserId            String?
  assignedUser              User?    @relation(fields: [assignedUserId], references: [id])
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  jobOffers                 JobOffer[]
  actions                   Action[]
  notes                     Note[]
  importRows                ImportRow[]
  emailLogs                 EmailLog[]
  candidateCalls            CandidateCall[]
  callLogs                  CallLog[]
  moves                     DealMove[]
  demoBookings              DemoBooking[]
  organizationLinks         DealOrganization[]
  offerNotifications        OfferNotification[]
  // Abonnements rattachés (1 à 3 par affaire). Les champs subscription* /
  // paymentMode / closingDate / dealValue ci-dessus sont conservés comme miroir
  // dénormalisé de l'abonnement principal (position 0) et de la somme des
  // valeurs, pour les cartes, totaux de colonnes et le dashboard.
  subscriptions             Subscription[]
}

// Un abonnement vendu sur une affaire (jusqu'à 2 par deal). Chaque abonnement
// porte sa propre valeur, son type, son mode/cadence de paiement, sa date de
// closing et sa durée (→ date de fin calculée).
model Subscription {
  id                  String   @id @default(cuid())
  dealId              String
  deal                Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  position            Int      @default(0)
  value               Float?
  subscriptionType    String   @default("")
  paymentMode         String   @default("stripe")
  paymentTiming       String   @default("comptant")
  closingDate         DateTime?
  subscriptionMonths  Int      @default(12)
  subscriptionEndDate DateTime?
  // CHURN : abonnement résilié. Quand true, la valeur de l'abonnement est
  // exclue du MRR et de toutes les autres données du Dashboard (route de closing
  // et analyses de l'assistant IA).
  churned             Boolean  @default(false)
  // Date de résiliation (churn), saisie via la pop-up au cochage de la case.
  // Sert à rattacher le client perdu à la bonne période pour le taux de churn.
  churnedAt           DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([dealId])
}

model JobOffer {
  id              String   @id @default(cuid())
  dealId          String
  deal            Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id])
  importBatchId   String
  importBatch     ImportBatch @relation(fields: [importBatchId], references: [id])
  externalOfferId String   @default("")
  title           String   @default("")
  jobTitle        String   @default("")
  contractType    String   @default("")
  salary          String   @default("")
  source          String   @default("")
  url             String   @default("")
  publishedAt     String   @default("")
  fingerprint     String   @unique
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ImportBatch {
  id                String   @id @default(cuid())
  fileName          String
  importedAt        DateTime @default(now())
  totalRows         Int      @default(0)
  createdDeals      Int      @default(0)
  updatedDeals      Int      @default(0)
  newOffers         Int      @default(0)
  movedToCall       Int      @default(0)
  errorCount        Int      @default(0)
  createdAt         DateTime @default(now())
  importRows        ImportRow[]
  jobOffers         JobOffer[]
}

model ImportRow {
  id            String   @id @default(cuid())
  importBatchId String
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  rowNumber     Int
  rawData       Json
  status        String   @default("ok")
  errorMessage  String   @default("")
  storeId       String?
  store         Store?   @relation(fields: [storeId], references: [id])
  dealId        String?
  deal          Deal?    @relation(fields: [dealId], references: [id])
  createdAt     DateTime @default(now())
}

model Action {
  id          String    @id @default(cuid())
  dealId      String
  deal        Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  title       String
  type        String    @default("Appeler")
  dueDate     DateTime  @db.Timestamptz
  dueTime     String    @default("")
  status      String    @default("todo")
  priority    String    @default("normale")
  note        String    @default("")
  completedAt DateTime?
  assignedUserId String?
  assignedUser   User?   @relation(fields: [assignedUserId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Note {
  id         String   @id @default(cuid())
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  content    String
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id])
  authorName String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model EmailTemplate {
  id        String     @id @default(cuid())
  name      String
  subject   String     @default("")
  body      String     @default("")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  emailLogs EmailLog[]
}

model EmailLog {
  id         String         @id @default(cuid())
  dealId     String
  deal       Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  templateId String?
  template   EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  to         String
  subject    String
  body       String
  status     String         @default("sent")
  resendId   String?
  openedAt   DateTime?
  sentAt     DateTime       @default(now())
  createdAt  DateTime       @default(now())
}

// Suivi CRM des appels aux candidats affichés dans l'onglet « Recrutement ».
// candidateId = id du Candidate dans la base produit Supabase. La présence
// d'une ligne signifie « candidat appelé » pour ce deal (case cochée).
model CandidateCall {
  id          String   @id @default(cuid())
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  candidateId String
  calledAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([dealId, candidateId])
}

// Journal des déplacements d'affaires : une ligne à CHAQUE changement d'étape,
// qu'il vienne du drag & drop du pipeline, du sélecteur d'étape de la fiche ou
// d'un import automatique. Conserve le couple pipeline + colonne au départ ET à
// l'arrivée (un changement de pipeline est un déplacement comme un autre), plus
// l'auteur du mouvement.
//
// Les colonnes et pipelines sont référencés par id BRUT, sans clé étrangère, et
// doublés de leur nom figé au moment du déplacement : une étape renommée ou
// supprimée ne doit pas réécrire ni effacer l'historique.
model DealMove {
  id               String   @id @default(cuid())
  dealId           String
  deal             Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromColumnId     String?
  fromColumnTitle  String   @default("")
  fromPipelineId   String?
  fromPipelineName String   @default("")
  toColumnId       String?
  toColumnTitle    String   @default("")
  toPipelineId     String?
  toPipelineName   String   @default("")
  // Auteur du déplacement. Null pour les mouvements automatiques (import).
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName         String   @default("")
  // Origine : "pipeline" (drag & drop), "fiche" (sélecteur d'étape de la fiche
  // affaire) ou "import" (retour automatique en « À appeler », déplacement
  // demandé lors d'un import CSV).
  source           String   @default("pipeline")
  movedAt          DateTime @default(now())

  @@index([dealId, movedAt])
  @@index([movedAt])
  @@index([userId, movedAt])
}

// Historique des démos bookées : une ligne est créée à CHAQUE passage d'une
// affaire dans la colonne « DEMO PREVUE » du pipeline Closing. Même principe
// que le compteur d'appels (CallLog) : on ajoute, on n'écrase jamais — un
// rebooking crée une NOUVELLE ligne à côté de la précédente, ce qui permet de
// compter les démos bookées par utilisateur sur une période et de garder la
// trace des démos qui ont fini en no-show.
model DemoBooking {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  // Auteur du booking = utilisateur qui a déplacé l'affaire dans la colonne.
  // Null pour un déplacement automatique ou un compte supprimé depuis.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Nom figé à l'enregistrement : la statistique reste lisible même si le
  // compte est renommé ou supprimé.
  userName  String   @default("")
  // Date à laquelle la démo a été bookée (= entrée dans la colonne).
  bookedAt  DateTime @default(now())
  // Date de la démo elle-même. Photographiée à la création puis maintenue à
  // jour tant que la ligne est le booking le plus récent de l'affaire (la date
  // est souvent renseignée sur la fiche juste après le déplacement).
  demoDate  DateTime?
  // Case « NO SHOW » de la fiche affaire : le contact n'est pas venu.
  noShow    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId, bookedAt])
  @@index([bookedAt])
  @@index([userId, bookedAt])
}

// Compteur d'appels : une ligne est créée à CHAQUE clic sur « Afficher le
// numéro » dans la fiche affaire. Sert à mesurer le nombre d'appels passés par
// utilisateur sur une période (semaine, quinzaine, mois…). Le nom de
// l'utilisateur est figé à l'enregistrement pour que la statistique reste
// lisible même si le compte est renommé ou supprimé.
model CallLog {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String   @default("")
  // Numéro affiché au moment du clic (trace de ce qui a été composé).
  phone     String   @default("")
  calledAt  DateTime @default(now())
  // Le décisionnaire a-t-il pu être joint lors de cet appel ? On passe toujours
  // par l'accueil du magasin avant de le demander : cette réponse distingue les
  // appels réellement utiles des simples passages par le standard.
  // Renseigné par la pop-up affichée 20 s après le clic sur « Afficher le
  // numéro » ; reste null tant que l'utilisateur n'a pas répondu.
  connected Boolean?

  @@index([calledAt])
  @@index([userId, calledAt])
  @@index([dealId])
}

// Organisations produit (Supabase) rattachées à un deal. Permet d'en lier
// plusieurs (en plus de Deal.supabaseOrganizationId issu du provisioning) et
// de les renseigner manuellement quand l'auto-rattachement par nom échoue.
model DealOrganization {
  id             String   @id @default(cuid())
  dealId         String
  deal           Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  organizationId String
  createdAt      DateTime @default(now())

  @@unique([dealId, organizationId])
}

// Trace CRM des offres créées côté produit (Supabase) par les Organizations
// rattachées à une affaire. Alimentée en LECTURE SEULE depuis Supabase (rien
// n'y est écrit) : à chaque relevé, les nouvelles offres de la table Offer
// (id, title, organization_id, created_at) sont enregistrées ici. Sert à trois
// usages : trace « Nouvelle offre créée » dans l'onglet Activité, point bleu sur
// la carte de l'affaire, et centre de notifications du pipeline. isRead distingue
// une offre nouvellement apparue (point bleu) d'une offre déjà acquittée.
model OfferNotification {
  id             String   @id @default(cuid())
  dealId         String
  deal           Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  organizationId String
  // Id de l'Offer dans Supabase produit (unique par offre).
  offerId        String
  offerTitle     String   @default("")
  // Date de publication de l'offre (Offer.created_at côté Supabase).
  offerCreatedAt DateTime
  // False = nouvelle offre non acquittée (déclenche point bleu + badge).
  isRead         Boolean  @default(false)
  // Date de découverte de l'offre côté CRM (relevé Supabase).
  createdAt      DateTime @default(now())

  @@unique([dealId, offerId])
  @@index([dealId])
}

// Réglages globaux de l'application (clé/valeur). Ex. « emailSignature » :
// signature HTML ajoutée automatiquement à tous les emails envoyés du CRM.
model AppSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

// Attribution des liens de paiement « classiques » aux cases du plan tarifaire.
//
// Le plan lui-même (7 offres × 2 jeux de tarifs × 3 modes de paiement = 42 cases)
// est décrit en dur dans src/lib/paymentLinkSlots.ts : il ne change pas au gré
// des données. Cette table dit seulement QUEL Payment Link Stripe occupe QUELLE
// case — c'est ce qu'on renseigne depuis Paramètres › Liens de paiement.
//
// Une case sans ligne ici est simplement vide (non sélectionnable côté affaire).
// Un lien Stripe actif qui n'occupe aucune case est un lien « spécial », créé
// pour un client donné : la distinction classique/spécial se déduit de cette
// table, il n'y a rien d'autre à cocher.
model PaymentLinkSlot {
  // Clé de la case, ex. « c1-mois/actuel/mensuel » (voir buildSlotKey).
  slotKey      String   @id
  // Id du Payment Link Stripe (plink_…). Volontairement NON unique : rien
  // n'interdit qu'un même lien serve deux cases (l'écran de paramétrage le
  // signale, mais ne le refuse pas).
  stripeLinkId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([stripeLinkId])
}
